                        <ScrollViewer x:Name="TaskbarLyricsView" Visibility="Collapsed" Style="{StaticResource FadeInUpViewStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,12">
