                                        <Setter Property="Text" Value="&#xE72A;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                <Setter Property="Text" Value="&#xE8B7;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="切换"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Text" Value="当前"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                <Setter Property="Text" Value="找回账号"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding IsPinned}" Width="32" Height="32" Cursor="Hand" ToolTip="置顶此账号" AutomationProperties.Name="置顶此账号">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Width="32" Height="32" x:Name="pb">
                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5" x:Name="pi"/>
