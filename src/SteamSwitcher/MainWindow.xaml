                                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBgBrush}" Margin="0,0,12,0"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
