                        </StackPanel>
                    </Border>

                    <!-- 右侧：Steam 运行状态徽章与窗口控制按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="6" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                </Border>
                                <TextBlock Text="STEAM" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource BtnWindow}" Command="{Binding RefreshCommand}" ToolTip="重新读取本地账号列表" AutomationProperties.Name="刷新账号列表" Width="76" Height="36" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="刷新" FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12"/></StackPanel></Button>
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnWindow}" Click="Minimize_Click" ToolTip="最小化" Width="46" Height="36" VerticalAlignment="Center"/>
                        <Button x:Name="BtnWindowMaximize" Style="{StaticResource BtnMaximize}" Click="Maximize_Click" Width="46" Height="36" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GlyphWhenRestored}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE923;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GlyphWhenMaximized}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnClose}" Click="Close_Click" ToolTip="{Binding CloseButtonToolTip}" Width="48" Height="36" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="0" Height="0.5" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>

            <!-- 主体 (左右分栏，侧边栏通底) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：全局侧边栏 (Apple / Fluent 优雅分组) -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
                    <DockPanel Margin="12,12,12,14" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <!-- 分组 1: LIBRARY -->
                            <TextBlock Text="游戏与账号" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelBrush}" Margin="12,8,12,8"/>
                            <!-- 账号 -->
                            <Grid Margin="0,0,0,4">
                                <Border x:Name="SideAccentAccount" Width="3" Height="18" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Panel.ZIndex="2" IsHitTestVisible="False"/>
                                <Button x:Name="SideAccounts" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideAccounts_Click" ToolTip="多账号保存、查找与找回">
                                    <Grid Margin="13,0,10,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="多账号库" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <Border Grid.Column="2" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AccountCountText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>
                            
                            <!-- 游戏 -->
                            <Grid Margin="0,0,0,4">
                                <Border x:Name="SideAccentGame" Width="3" Height="18" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Panel.ZIndex="2" IsHitTestVisible="False"/>
                                <Button x:Name="SideGames" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideGames_Click" ToolTip="Steam 游戏库与账号绑定">
                                    <Grid Margin="13,0,10,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="游戏绑定" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <Border Grid.Column="2" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameCountText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- 存档中心 -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding GameSaveCenterEnabled, Converter={StaticResource BoolToVis}}">
                                <Border x:Name="SideAccentSave" Width="3" Height="18" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Panel.ZIndex="2" IsHitTestVisible="False"/>
                                <Button x:Name="SideSaveCenter" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideSaveCenter_Click" ToolTip="游戏存档备份与同步中心">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="13,0,10,0">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="游戏存档" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <!-- 快捷启动 -->
                            <Grid Margin="0,0,0,8">
                                <Border x:Name="SideAccentQuickLaunch" Width="3" Height="18" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Panel.ZIndex="2" IsHitTestVisible="False"/>
                                <Button x:Name="SideQuickLaunch" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideQuickLaunch_Click" ToolTip="快捷启动面板">
                                    <Grid Margin="13,0,10,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="快捷启动" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <Border Grid.Column="2" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding QuickLaunchCountText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- 分组 2: SYSTEM -->
                            <TextBlock Text="桌面体验" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelBrush}" Margin="12,16,12,8"/>

                            <!-- 桌面图标智能隐藏 -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding DesktopIconHiderEnabled, Converter={StaticResource BoolToVis}}">
                                <Border x:Name="SideAccentDesktopIcons" Width="3" Height="18" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Panel.ZIndex="2" IsHitTestVisible="False"/>
                                <Button x:Name="SideDesktopIcons" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideDesktopIcons_Click" ToolTip="桌面图标智能隐藏与沉浸模式">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="13,0,10,0">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="桌面图标" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 任务栏歌词 -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding TaskbarLyricsModuleEnabled, Converter={StaticResource BoolToVis}}">
                                <Border x:Name="SideAccentTaskbarLyrics" Width="3" Height="18" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Panel.ZIndex="2" IsHitTestVisible="False"/>
                                <Button x:Name="SideTaskbarLyrics" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideTaskbarLyrics_Click" ToolTip="任务栏滚动歌词与音乐控制">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="13,0,10,0">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="任务栏歌词" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 侧边栏底部：设置、Mini-Account 状态卡片、版本信息 -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <!-- 设置 -->
                            <Grid Margin="0,0,0,6">
                                <Border x:Name="SideAccentSettings" Width="3" Height="18" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Panel.ZIndex="2" IsHitTestVisible="False"/>
                                <Button x:Name="SideSettings" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideSettings_Click" ToolTip="偏好设置">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="13,0,10,0">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="偏好设置" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Mini-Account 状态卡片 -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,8,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AvatarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding CurrentAccountViewModel.Avatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentAccountViewModel.Avatar}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentAccountViewModel.DisplayName, TargetNullValue=未登录, FallbackValue=未登录}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SteamStatusText, FallbackValue='Steam 未运行'}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="6" Height="6" CornerRadius="2" VerticalAlignment="Center" Margin="3,0,2,0">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 版本号 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Border Width="5" Height="5" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CompactVersionText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9.5"/>
                                <TextBlock Text=" · 已是最新版本" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9.5"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                
                <!-- 侧边栏与内容分割线 -->
                <Border Grid.Column="0" Width="0.5" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Right"/>

                <!-- 右侧：主内容区 -->
                <Grid Grid.Column="1" Margin="28,24,28,22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="PageHeader" Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Text="多账号库" Foreground="{DynamicResource PageHeaderBrush}" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageSubtitle" Text="双击卡片快速切换 Steam 身份，支持置顶常用账号。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="6" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                </Border>
                                <TextBlock Text="{Binding SteamStateText, StringFormat=Steam {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1">
                    <!-- 账号视图 (Apple Concept Layout) -->
                    <!-- 固定工作台：整页不滚动，账号过多时仅在账号列表区域内滚动。 -->
                    <Grid x:Name="AccountView" Style="{StaticResource FadeInUpViewStyle}" Margin="0" ClipToBounds="True">
                        <Border Background="Transparent" BorderThickness="0" Padding="0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="AccountPageIntro" Margin="0,0,18,0">
                                <TextBlock Text="多账号库" Foreground="{DynamicResource PageHeaderBrush}" FontSize="28" FontWeight="SemiBold"/>
                                <TextBlock Text="Steam 列表找不到的历史账号，在这里查找与找回。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="AccountArchiveButton" Grid.Column="1" Click="AccountArchiveMenu_Click" Style="{StaticResource SecondaryBtn}" Height="36" Padding="14,0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="账号档案管理" ToolTip="本地账号库：导入、导出、遗忘或恢复收录账号元数据">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="更多管理" Foreground="{DynamicResource AccentBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            </Grid>
                            <!-- 工具栏：搜索、筛选和展示方式收在同一行。 -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Height="40" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="AccountSearchBox" Text="搜索昵称、登录名或 SteamID..." Background="Transparent" BorderThickness="0" Padding="0,0,12,0" VerticalContentAlignment="Center" FontSize="14"
                                                 AutomationProperties.Name="搜索本地账号库" ToolTip="搜索昵称、登录名或 Steam ID（Ctrl+F）；Esc 清除搜索"
                                                 TextChanged="AccountSearchBox_TextChanged" GotFocus="AccountSearchBox_GotFocus" LostFocus="AccountSearchBox_LostFocus"/>
                                        <Button x:Name="ClearAccountSearchButton" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="28" Height="28" Margin="0,0,5,0" Padding="0" Visibility="Collapsed" Style="{StaticResource SecondaryBtn}" Click="ClearAccountSearch_Click" ToolTip="清除搜索（Esc）" AutomationProperties.Name="清除账号搜索"/>
                                    </Grid>
                                </Border>
                                <Button x:Name="AccountFilterButton" Grid.Column="1" Style="{StaticResource SecondaryBtn}" Height="40" Margin="0,0,12,0" ToolTip="筛选账号" Click="AccountFilterButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="全部账号" Tag="All" Click="AccountFilterOption_Click"/>
                                            <MenuItem Header="当前账号" Tag="Current" Click="AccountFilterOption_Click"/>
                                            <MenuItem Header="已固定账号" Tag="Pinned" Click="AccountFilterOption_Click"/>
                                            <MenuItem Header="待找回账号" Tag="Archived" Click="AccountFilterOption_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="AccountFilterText" Text="全部账号" FontSize="12.5"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="10,0,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="AccountSortButton" Grid.Column="2" Style="{StaticResource SecondaryBtn}" Height="40" Margin="0,0,12,0" ToolTip="更改账号排序" Click="AccountSortButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="最近登录" Tag="Recent" Click="AccountSortOption_Click"/>
                                            <MenuItem Header="账号名称" Tag="Name" Click="AccountSortOption_Click"/>
                                            <MenuItem Header="固定优先" Tag="Pinned" Click="AccountSortOption_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="AccountSortText" Text="排序：最近登录" FontSize="12.5"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="10,0,0,0"/></StackPanel>
                                </Button>
                                <Border Grid.Column="4" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Height="40" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AccountListViewButton" Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" ToolTip="列表视图" Cursor="Hand" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SelectedBgBrush}" BorderThickness="0" Width="34" Height="30" Click="AccountListView_Click"/>
                                        <Button x:Name="AccountGridViewButton" Content="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="15" ToolTip="网格视图" Cursor="Hand" Foreground="{DynamicResource TextSecondaryBrush}" Background="Transparent" BorderThickness="0" Width="34" Height="30" Click="AccountGridView_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                                                        <!-- 多账号保存：主入口直接说明本地保留、找回与备份。 -->
                            <Border x:Name="AccountLibraryHero" Grid.Row="2" Background="{DynamicResource AccentBgBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,12" Margin="0,0,0,16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="226"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="多账号保存 · 自动收录" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                        <TextBlock x:Name="AccountLibrarySummary" Text="{Binding AccountLibrarySummaryText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="AccountLibraryCounts" Text="{Binding AccountLibraryCountsText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                        <TextBlock Text="仅保存账号资料，不保存密码；找回后可能需要重新验证登录。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button x:Name="CollectAccountsButton" Content="收录账号" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryBtn}" Height="36" Margin="0,0,6,0" Padding="8,0" ToolTip="读取 Steam 当前记录中的账号，并合并到本地账号库"/>
                                            <Button x:Name="ShowRecoveryAccountsButton" Grid.Column="1" Content="{Binding AccountRecoveryButtonText}" Click="ShowRecoveryAccounts_Click" IsEnabled="{Binding HasArchivedAccounts}" Style="{StaticResource SecondaryBtn}" Height="36" Padding="8,0" ToolTip="查看仅保存在本地、Steam 当前未列出的账号"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button x:Name="ImportAccountsButton" Content="导入账号库" Click="ImportAccountArchive_Click" Style="{StaticResource SecondaryBtn}" Height="30" FontSize="11.5" Padding="8,0" Margin="0,0,6,0" ToolTip="从本程序导出的账号资料文件合并记录"/>
                                            <Button x:Name="BackupAccountsButton" Grid.Column="1" Content="备份账号库" Click="ExportAccountArchive_Click" IsEnabled="{Binding CanExportBackup}" Style="{StaticResource SecondaryBtn}" Height="30" FontSize="11.5" Padding="8,0" ToolTip="导出本地账号资料，不包含密码或登录凭据"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Account workbench: list on the left, selected-account details on the right. -->
                            <Grid x:Name="AccountWorkbench" Grid.Row="3" Margin="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid x:Name="AccountListPanel" Grid.Column="0" Margin="0,0,24,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Margin="2,4,2,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
                                                <TextBlock x:Name="AccountListHeading" Text="全部已收录账号" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AccountResultsSummary" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="13,5,8,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                        <Button x:Name="ShowAllSavedAccountsButton" Grid.Column="1" Content="查看全部" Click="ShowAllSavedAccounts_Click" Style="{StaticResource SecondaryBtn}" Height="28" FontSize="11.5" Padding="10,0" ToolTip="清除搜索和筛选，显示全部收录账号"/>
                                    </Grid>
                                    <ListBox Grid.Row="1" x:Name="AccountListBox" ItemsSource="{Binding Source={StaticResource FilteredAccounts}}" SelectedItem="{Binding SelectedAccount}"
                                             Style="{StaticResource AccountList}" ItemTemplate="{StaticResource AccountItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="AccountListBox_MouseDoubleClick"/>
                                    <Border x:Name="AccountResultsEmptyState" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,16">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="AccountResultsEmptyTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="AccountResultsEmptyHint" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,14"/>
                                            <Button x:Name="ResetAccountFiltersButton" Content="清除条件，查看全部" Click="ShowAllSavedAccounts_Click" Style="{StaticResource SecondaryBtn}" Height="34" HorizontalAlignment="Center"/>
                                            <Button x:Name="EmptyCollectAccountsButton" Content="从 Steam 收录账号" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryBtn}" Height="34" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Row="2" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryBtn}" Height="40" Margin="0,8,6,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="收录 / 刷新 Steam 账号" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                                    </Button>
                                </Grid>
                                <Border x:Name="AccountDetailPanel" Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                                    <Grid>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource AvatarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,14,0">
                                                <Grid><Image Source="{Binding SelectedAccount.Avatar}" Stretch="UniformToFill"/><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedAccount.DisplayName, TargetNullValue=选择一个账号}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SelectedAccount.Username, StringFormat=登录名 · {0}, TargetNullValue=登录名 · -}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource AccentBgBrush}" CornerRadius="9" Padding="9,5" VerticalAlignment="Center">
                                                <TextBlock Text="已选中" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,14,0,12"/>
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                        <StackPanel>
                                            <!-- 本地账号库提示：选中的账号已被 Steam 裁掉时给出找回指引 -->
                                            <Border Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningFgBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedAccount.IsArchived}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningFgBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="账号仅保存在本地库中" Foreground="{DynamicResource WarningFgBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="本地记录仍在。使用下方找回按钮即可恢复记录。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                                                                        <UniformGrid Columns="3" Margin="0,4,0,0">
                                                <StackPanel><TextBlock Text="Steam 进程" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/><TextBlock Text="{Binding SteamStateText}" FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                                <StackPanel><TextBlock Text="最近登录" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedAccount.LastLoginText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                <StackPanel><TextBlock Text="此账号绑定游戏" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/><TextBlock x:Name="SelectedAccountBindingCount" Text="{Binding SelectedAccountBoundGameCount, StringFormat={}{0} 款}" Foreground="{DynamicResource AccentBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                        </ScrollViewer>
                                        <StackPanel Grid.Row="3" Margin="0,12,0,0">

                                            <Button x:Name="SelectedAccountActionButton" Command="{Binding SwitchAndLaunchCommand}" IsEnabled="{Binding CanUseSelectedAccount}" Style="{StaticResource PrimaryBtn}" Height="44" AutomationProperties.Name="{Binding AccountActionLabel}" AutomationProperties.HelpText="{Binding AccountActionHint}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/><TextBlock x:Name="SelectedAccountActionLabel" Text="{Binding AccountActionLabel}" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
                                            <TextBlock x:Name="SelectedAccountActionHint" Text="{Binding AccountActionHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Click="SideSaveCenter_Click" Style="{StaticResource SecondaryBtn}" Height="40" Margin="0,0,5,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="查看存档" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/></StackPanel></Button><Button Grid.Column="1" Click="CreateAccountShortcut_Click" Style="{StaticResource SecondaryBtn}" Height="40" Margin="5,0,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="创建桌面快捷方式" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/></StackPanel></Button></Grid>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource AccentBgBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="先选择一个账号"/><Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Text" Value="尚未读取到账号"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="单击左侧账号卡片，确认右侧操作目标后再切换。"/><Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Text" Value="先在 Steam 登录一次，再点击下方按钮重新读取账号。"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="重新扫描账号" Command="{Binding RefreshCommand}" Width="160" Height="40" Margin="0,18,0,0" HorizontalAlignment="Center"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid></Grid></Border></Grid>
                        <!-- 游戏视图 -->
                        <Grid x:Name="GameView" Visibility="Collapsed" Style="{StaticResource FadeInUpViewStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

                            <!-- 左侧：游戏列表 -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" Padding="13,0" Height="48" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="13.5"/>
                                            <TextBox Grid.Column="1" x:Name="GameSearchBox" Text="搜索游戏、AppID 或启动账号..." Background="Transparent" Foreground="{DynamicResource SearchPlaceholderFgBrush}" BorderThickness="0" CaretBrush="{DynamicResource TextPrimaryBrush}" FontSize="14" Padding="2,0" VerticalAlignment="Center"
                                                      TextChanged="GameSearchBox_TextChanged" GotFocus="GameSearchBox_GotFocus" LostFocus="GameSearchBox_LostFocus"/>
                                            <Button Grid.Column="2" x:Name="GameClearSearch" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="24" Height="24" FontSize="10" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="GameClearSearch_Click" Visibility="Collapsed">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="cb" Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="1" Click="GameScan_Click" Width="104" Height="48" Style="{StaticResource PrimaryBtn}" IsEnabled="{Binding IsGameScanInProgress, Converter={StaticResource InverseBool}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="扫描游戏" FontSize="12.5" FontWeight="SemiBold"/></StackPanel>
                                    </Button>
                                    <ComboBox x:Name="GameFilterCombo" Grid.Column="2" Width="104" Height="48" Margin="8,0,0,0" Style="{StaticResource SaveComboBox}" SelectedValuePath="Tag" SelectionChanged="GameFilter_SelectionChanged" ToolTip="筛选已绑定或未绑定游戏">
                                        <ComboBoxItem Content="全部游戏" Tag="All" IsSelected="True"/>
                                        <ComboBoxItem Content="已绑定" Tag="Bound"/>
                                        <ComboBoxItem Content="未绑定" Tag="Unbound"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Grid.Row="1" Margin="2,0,2,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GameScanStatus" Text="已安装游戏" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="选择游戏后绑定启动账号" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Background="{DynamicResource CardBgAltBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <ListBox x:Name="GameListBox" ItemsSource="{Binding GameList}" SelectedItem="{Binding SelectedGame}"
                                                 Background="Transparent" BorderThickness="0" Padding="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource GameListItemStyle}"
                                                 ItemTemplate="{StaticResource GameItemTemplate}"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.CanContentScroll="True"/>
                                        <TextBlock x:Name="GameEmptyHint" Text="点击 [扫描] 加载本地 Steam 游戏" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>

                                <Button Grid.Row="3" Click="ManualAddToggle_Click" Margin="0,10,0,0" Height="44" Style="{StaticResource SecondaryBtn}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="手动添加游戏" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/></StackPanel></Button>

                                <!-- 手动添加面板 -->
                                <Border Grid.Row="4" x:Name="ManualAddPanel" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,12"
                                        Margin="0,8,0,0" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="104"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="AppID" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" x:Name="ManualAppId" Height="42" Style="{StaticResource FormTextBoxStyle}" FontSize="13" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="游戏名" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="3" x:Name="ManualGameName" Height="42" Style="{StaticResource FormTextBoxStyle}" FontSize="13" Margin="0,0,12,0"/>
                                        <Button Grid.Column="4" Content="添加" Click="ManualAddBinding_Click" Width="74" Height="42" Style="{StaticResource PrimaryBtn}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 右侧：绑定面板 -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="16" Padding="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <!-- 顶部彩色标题条 -->
                                    <Border Grid.Row="0" Background="{DynamicResource AccentBgBrush}" CornerRadius="15,15,0,0" Padding="16,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="绑定设置" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15.5" FontWeight="Bold"/>
                                                <TextBlock Text="选游戏 → 选账号 → 保存" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- 选中的游戏信息卡片 -->
                                    <Border Grid.Row="1" Background="{DynamicResource CardBgAltBrush}" CornerRadius="12" Padding="12,10" Margin="14,10,14,10"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBgBrush}" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedGameName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SelectedGameAppId, StringFormat='AppID {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="1" CornerRadius="9" Padding="10,7" Margin="0,9,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedGameHasBinding}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/><Setter Property="BorderBrush" Value="#6634C759"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,9,0">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameHasBinding}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="当前启动账号" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9"/>
                                                        <TextBlock Text="{Binding SelectedGameBindingAccount}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameHasBinding}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding SelectedGameBindingTime, StringFormat='最后启动 · {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="14,0,14,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="选择启动账号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="选中账号后点下方「保存绑定」" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9"/>
                                    </Grid>
                                    <ListBox Grid.Row="3" x:Name="GameAccountList" ItemsSource="{Binding Accounts}"
                                             SelectedItem="{Binding SelectedBindingAccount}" Background="Transparent"
                                             BorderThickness="0" Margin="14,0,14,12" Padding="2">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                            <Setter Property="Height" Value="50"/><Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                                <Border CornerRadius="8" Margin="0,2" x:Name="abi"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="0" Y="0" x:Name="trans"/>
                                                    </Border.RenderTransform>
                                                    <Grid>
                                                        <Border CornerRadius="8" Background="{DynamicResource HoverBgBrush}" Opacity="0" x:Name="hoverBg"/>
                                                        <Border CornerRadius="8" Background="{DynamicResource SelectedBgBrush}" Opacity="0" x:Name="selectBg">
                                                        </Border>
                                                        <Grid Margin="9,0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AvatarBgBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                 <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                 <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"
                                                                    Style="{StaticResource StatusBadgeStyle}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="当前" Foreground="{DynamicResource SuccessFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
