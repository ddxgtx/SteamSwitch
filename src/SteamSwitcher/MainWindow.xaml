                                    <ToggleButton Grid.Column="2" IsChecked="{Binding IsPinned, Mode=OneWay}" Click="QuickLaunchPinToggle_Click" Tag="{Binding Id}" Width="40" Height="40" Cursor="Hand" Margin="4,0" ToolTip="固定或取消固定" AutomationProperties.Name="固定或取消固定快捷启动项目">
                                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Width="40" Height="40" x:Name="pb">
                                                <TextBlock Text="&#xE840;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" x:Name="pi"/>
