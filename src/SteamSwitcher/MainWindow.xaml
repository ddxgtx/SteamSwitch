                                                    <Border Padding="14,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="关闭 Steam 时显示通知" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                                                <TextBlock Text="成功关闭 Steam 后弹出系统通知" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,14,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding ShowNotificationOnSteamClose}" Checked="SettingsNotificationOnClose_Changed" Unchecked="SettingsNotificationOnClose_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <!-- 维护与排障 -->
                                            <StackPanel Orientation="Horizontal" Margin="6,14,6,10">
                                                <Border Height="12" Width="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="维护与排障" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" Margin="0,0,6,12" Padding="14,12"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Text="诊断与排障工具" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="检查 Steam、存档、歌词、桌面图标与配置目录状态" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,14,0" TextWrapping="Wrap"/>
                                                        <TextBlock x:Name="DiagnosticSummaryText" Text="尚未运行诊断" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Left" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="420"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                        <TextBlock Text="诊断与日志" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                                        <WrapPanel x:Name="DiagnosticsActionsPanel" Orientation="Horizontal">
                                                        <Button Content="复制诊断信息" Click="CopyDiagnostics_Click" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        <Button Content="运行诊断" Click="RunDiagnostics_Click" AutomationProperties.Name="运行系统诊断" Style="{StaticResource PrimaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        <Button Content="一键修复" Click="RepairDiagnostics_Click" AutomationProperties.Name="一键修复诊断问题" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        <Button Content="导出报告" Click="ExportDiagnosticReport_Click" AutomationProperties.Name="导出诊断报告" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        <Button Content="打开异常日志" Click="OpenCrashLog_Click" AutomationProperties.Name="打开异常日志" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        <Button Content="清除异常记录" Click="ClearCrashLog_Click" AutomationProperties.Name="清除异常退出记录" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        </WrapPanel>
                                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12"/>
                                                        <TextBlock Text="配置备份与迁移" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                                        <WrapPanel x:Name="ConfigurationTransferActionsPanel" Orientation="Horizontal">
                                                        <Button x:Name="ExportSettingsButton" Content="导出设置" Click="ExportSettings_Click" IsEnabled="{Binding CanExportBackup}" AutomationProperties.Name="导出全部设置" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        <Button x:Name="ExportConfigurationBundleButton" Content="导出应用配置包" Click="ExportConfigurationBundle_Click" IsEnabled="{Binding CanExportBackup}" ToolTip="包含设置、账号元数据、游戏绑定和快速启动；不包含登录凭据及游戏存档文件" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        <Button Content="导入应用配置包" Click="ImportConfigurationBundle_Click" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        <Button Content="导入设置" Click="ImportSettings_Click" AutomationProperties.Name="导入设置文件" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                                                        </WrapPanel>
                                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12"/>
                                                        <TextBlock Text="布局与恢复" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                                        <WrapPanel x:Name="RecoveryActionsPanel" Orientation="Horizontal">
                                                        <Button Content="重置窗口布局" Click="ResetWindowLayout_Click" AutomationProperties.Name="重置窗口布局" Style="{StaticResource SecondaryBtn}" Height="34" Padding="14,0"/>
                                                        <Button Content="恢复全部默认" Click="ResetAllSettings_Click" AutomationProperties.Name="恢复全部默认设置" Style="{StaticResource DangerBtn}" Height="34" Padding="14,0" Margin="8,0,0,0"/>
                                                        <Button Content="紧急恢复系统状态" Click="EmergencyRestore_Click" AutomationProperties.Name="紧急恢复系统状态" Style="{StaticResource DangerBtn}" Height="34" Padding="14,0" Margin="8,0,0,0"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 底部栏：快捷开关 + GitHub（操作反馈已移至窗口右上角瞬时提示） -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <CheckBox Content="切换后启动 Steam" IsChecked="{Binding AutoStartSteam}" Checked="SettingsAutoStartSteam_Changed" Unchecked="SettingsAutoStartSteam_Changed" Style="{StaticResource AppCheckBox}" ToolTip="普通账号切换成功后自动启动 Steam"/>
                    <CheckBox Content="切换时强制关闭" IsChecked="{Binding SilentCloseSteam}" Checked="SettingsSilentCloseSteam_Changed" Unchecked="SettingsSilentCloseSteam_Changed" Style="{StaticResource AppCheckBox}" Margin="16,0,0,0" ToolTip="普通账号切换时强制结束 Steam 进程树"/>
                    <Border Background="{DynamicResource AccentBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="18,0,4,0" Cursor="Hand" MouseLeftButtonDown="GitHubLink_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="GitHub" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 加载遮罩 - 覆盖全窗口 -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Background="#66091424" Grid.RowSpan="3">
                <Border x:Name="OperationBusyCard" Width="400" Padding="28" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- 加载图标 -->
                    <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="正在处理" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <!-- 进度条 -->
                    <Border Width="140" Height="4" CornerRadius="2" Background="{DynamicResource InputBgBrush}" Margin="0,0,0,12">
                        <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"/>
                    </Border>
                    <TextBlock x:Name="OperationBusyText" Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                    <TextBlock Text="完成后会自动恢复操作，请稍候。" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" FontSize="11.5" Margin="0,10,0,0"/>
                </StackPanel>
                </Border>
            </Border>

            <!-- 操作反馈：内容区右下角悬浮提示胶囊（避开顶部标题区按钮，杜绝遮挡） -->
            <Border x:Name="ToastHost" Visibility="Collapsed" Grid.Row="1"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,20"
                    MinWidth="268" MaxWidth="448" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="14,11" AutomationProperties.LiveSetting="Polite">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.24"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ToastIconBadge" Width="28" Height="28" CornerRadius="9" Background="{DynamicResource AccentBgBrush}" Margin="0,0,11,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastIcon" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ToastText" Grid.Column="1" Text="{Binding StatusText}" MinWidth="196" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="ToastActionButton" Visibility="Collapsed" Grid.Column="2" Margin="12,0,0,0"
                            Style="{StaticResource SecondaryBtn}" Height="28" Padding="10,0" Click="ToastActionButton_Click"/>
                    <Button x:Name="ToastCloseButton" Grid.Column="3" Margin="8,0,0,0" Width="28" Height="28"
                            Cursor="Hand" ToolTip="关闭" Click="ToastCloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBg" Width="28" Height="28" CornerRadius="8" Background="Transparent">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBg" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 调整大小手柄 -->
            <Thumb Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="20" Height="20" Margin="0,0,2,2" Cursor="SizeNWSE"
                   DragStarted="ResizeGrip_DragStarted"
                   DragDelta="ResizeGrip_DragDelta"
                   Background="Transparent">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Path Data="M4,16 L16,4 M10,16 L16,10 M16,16 L16,16" 
                                  Stroke="{DynamicResource TextTertiaryBrush}" 
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right" 
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,2,2"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
