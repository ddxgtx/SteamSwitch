                                                    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="组件内边距" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><Slider x:Name="SettingsTaskbarWindowSizeSlider" Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TaskbarWindowSize}" ValueChanged="SettingsTaskbarWindowSize_ValueChanged" AutomationProperties.Name="任务栏组件内边距"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding TaskbarWindowSize, StringFormat={}{0} px}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextAlignment="Right"/></Grid>
