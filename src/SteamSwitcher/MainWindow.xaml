                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasBinding}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
