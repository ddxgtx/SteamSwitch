                                        </StackPanel>
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" Margin="6,0,6,10" Padding="14,12"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
