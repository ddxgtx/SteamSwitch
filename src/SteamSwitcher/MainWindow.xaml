                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding UseBetaUpdateChannel}" Checked="SettingsBetaUpdateChannel_Changed" Unchecked="SettingsBetaUpdateChannel_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <Border Background="{DynamicResource SeparatorBrush}" Height="0.5" Margin="14,0"/>
                                                <Border Padding="14,12" Style="{StaticResource SettingRowStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="启动时检查更新" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Text="打开应用时自动检查是否有新版本" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding CheckUpdateOnStartup}" Checked="SettingsCheckUpdate_Changed" Unchecked="SettingsCheckUpdate_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <Border Background="{DynamicResource SeparatorBrush}" Height="0.5" Margin="14,0"/>
                                                <Border Padding="14,12" Style="{StaticResource SettingRowStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="软件更新" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding CurrentVersionText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding GitHubReleasesUrl}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <Button Content="检查更新" Command="{Binding CheckForUpdatesManuallyCommand}" Style="{StaticResource SecondaryBtn}" Width="86" Height="32" Margin="0,0,8,0"/>
                                                            <Button Content="打开 GitHub" Command="{Binding OpenGitHubReleasesCommand}" Style="{StaticResource SecondaryBtn}" Width="96" Height="32"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border Background="{DynamicResource SeparatorBrush}" Height="0.5" Margin="14,0"/>
                                                <Border Padding="14,12" Style="{StaticResource SettingRowStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="自动更新" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Text="发现新版本后自动下载并启动安装器" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoInstallUpdates}" Checked="SettingsAutoInstallUpdates_Changed" Unchecked="SettingsAutoInstallUpdates_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <Border Background="{DynamicResource SeparatorBrush}" Height="0.5" Margin="14,0"/>
                                                <Border Padding="14,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="关闭 Steam 时显示通知" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Text="成功关闭 Steam 后弹出系统通知" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowNotificationOnSteamClose}" Checked="SettingsNotificationOnClose_Changed" Unchecked="SettingsNotificationOnClose_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- 维护与排障 -->
                                        <StackPanel Orientation="Horizontal" Margin="14,8,14,8">
                                            <Border Height="12" Width="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"/>
