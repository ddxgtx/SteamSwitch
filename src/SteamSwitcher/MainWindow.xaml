        <!-- 圆角调整大小手柄 -->
        <Style TargetType="ResizeGrip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ResizeGrip">
                        <Grid Background="Transparent" Width="16" Height="16">
                            <Path Data="M8,14 L14,8 M11,14 L14,11 M14,14 L14,14" 
                                  Stroke="{DynamicResource TextTertiaryBrush}" 
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right" 
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,2,2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 苹果风格侧边栏按钮样式 -->
        <Style x:Key="AppleSidebarBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarInactiveFgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 苹果风格 12px 圆角胶囊容器 -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" x:Name="b" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="sidebarShadow" Color="#0084FF" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停时如果是未选中状态，显示轻微悬浮灰 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Background" Value="Transparent"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </MultiTrigger>
                            
                            <!-- 悬停缩放动画 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- 点击按压收缩动画 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- 选中态（FontWeight为SemiBold时）冰蓝色呼吸外发光阴影 -->
                            <Trigger Property="FontWeight" Value="SemiBold">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sidebarShadow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="sidebarShadow" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sidebarShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="sidebarShadow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource WindowBgBrush}" CornerRadius="16" ClipToBounds="True" SnapsToDevicePixels="True" RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- 窗口底部星光溢光背景层 (极轻度发光叠加) -->
            <Border Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.08" CornerRadius="16" ClipToBounds="True">
                <Border.Background>
                    <RadialGradientBrush Center="0.85,0.15" GradientOrigin="0.85,0.15" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#007AFF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.06" CornerRadius="16" ClipToBounds="True">
                <Border.Background>
                    <RadialGradientBrush Center="0.15,0.85" GradientOrigin="0.15,0.85" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#5856D6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- 品牌标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}" Padding="0">
                <Grid Height="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左侧：品牌与产品定位 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentBgBrush}" Margin="0,0,11,0">
                            <Image Source="pack://siteoforigin:,,,/Resources/icon.png" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="STEAM" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text=" SWITCH" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <TextBlock Text="多账号切换与游戏启动中心" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 中间留空 (可用作拖动区域) -->
                    <Grid Grid.Column="1"/>

                    <!-- 右侧：刷新及控制按钮 (Windows 11 现代简约) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource BtnWindow}" Command="{Binding RefreshCommand}" ToolTip="刷新" Width="42" Height="58"/>
                        <Button Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource BtnWindow}" Click="Minimize_Click" ToolTip="最小化" Width="46" Height="58"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource BtnClose}" Click="Close_Click" ToolTip="关闭" Width="48" Height="58"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="0" Height="0.5" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>

            <!-- 主体 (左右分栏，侧边栏通底) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：全局侧边栏 -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
                    <DockPanel Margin="10,14,10,14" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <!-- 账号 -->
                            <Grid Margin="0,0,0,8">
                                <Border x:Name="SideAccentAccount" Width="0" Background="Transparent"/>
                                <Button x:Name="SideAccounts" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideAccounts_Click" ToolTip="账号列表">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="11,0">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="账号" FontSize="12" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <!-- 游戏 -->
                            <Grid Margin="0,0,0,8">
                                <Border x:Name="SideAccentGame" Width="0" Background="Transparent"/>
                                <Button x:Name="SideGames" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideGames_Click" ToolTip="游戏绑定">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="11,0">
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="游戏" FontSize="12" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <!-- 快速启动 -->
                            <Grid Margin="0,0,0,8">
                                <Border x:Name="SideAccentQuickLaunch" Width="0" Background="Transparent"/>
                                <Button x:Name="SideQuickLaunch" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideQuickLaunch_Click" ToolTip="快速启动">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="11,0">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="快启" FontSize="12" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 设置放在底部 -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Grid>
                                <Border x:Name="SideAccentSettings" Width="0" Background="Transparent"/>
                                <Button x:Name="SideSettings" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideSettings_Click" ToolTip="设置">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="11,0">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="设置" FontSize="12" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="8,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessFgBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding CompactVersionText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                
                <!-- 侧边栏与内容分割线 -->
                <Border Grid.Column="0" Width="0.5" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Right"/>

                <!-- 右侧：主内容区 -->
                <Grid Grid.Column="1" Margin="20,14,20,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Text="账号切换" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock x:Name="PageSubtitle" Text="选择账号并安全切换 Steam 登录状态" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SteamStateText, StringFormat=Steam {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1">
                    <!-- 账号视图 -->
                    <Grid x:Name="AccountView" Style="{StaticResource FadeInUpViewStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="202"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 账号搜索与摘要 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Height="40" Width="430" HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="AccountSearchBox" Text="搜索账号名称或登录名..." Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" FontSize="12"
                                             TextChanged="AccountSearchBox_TextChanged" GotFocus="AccountSearchBox_GotFocus" LostFocus="AccountSearchBox_LostFocus"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding AccountCountText, StringFormat={}{0} 个账号}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0,2,0"/>
                        </Grid>

                        <!-- 账号卡片 -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBgAltBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <ListBox ItemsSource="{Binding Source={StaticResource FilteredAccounts}}" SelectedItem="{Binding SelectedAccount}"
                                     Style="{StaticResource AccountList}" ItemTemplate="{StaticResource AccountItem}"/>
                        </Border>

                        <!-- 核心操作 -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding SwitchAndLaunchCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" Style="{StaticResource PrimaryBtn}" Height="50" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,9,0"/>
                                    <TextBlock Text="切换并启动 Steam" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="12,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding SwitchOnlyCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" Style="{StaticResource SecondaryBtn}" Height="50" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="仅切换账号" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 状态与扩展能力 -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                            <!-- 当前账号与切换策略 -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AvatarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Grid>
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding CurrentAccountViewModel.Avatar}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/></Image.Clip></Image>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentAccountViewModel.DisplayName, TargetNullValue=未检测账号}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CurrentAccountViewModel.Username, TargetNullValue=等待 Steam 登录数据}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding SteamStateText}" FontSize="9" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{DynamicResource SeparatorBrush}" Margin="0,9,0,0"/>
                                    <StackPanel Grid.Row="2" Margin="0,9,0,0">
                                        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="切换策略" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Grid.Column="2" Text="{Binding SwitchStrategyText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="启动行为" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Grid.Column="2" Text="{Binding LaunchBehaviorText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Grid>
                                    </StackPanel>
                                    <Border Grid.Row="3" Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="9,5" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,0,7,0"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/></Grid></Border>
                                </Grid>
                            </Border>

                            <!-- 账号与游戏数据概览 -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14" Margin="6,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentBgBrush}" Margin="0,0,9,0"><TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="数据概览" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="账号与游戏资源" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="{Binding GameBindingCoverage, StringFormat={}{0:F0}%}" Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/></Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="9,5" Margin="0,0,4,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="账号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding AccountCountText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
                                        <Border Grid.Column="1" Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="9,5" Margin="4,0,0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="游戏" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding GameCountText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
                                        <Border Grid.Row="1" Background="{DynamicResource SuccessBgBrush}" CornerRadius="9" Padding="9,5" Margin="0,4,4,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="已绑定" Foreground="{DynamicResource SuccessFgBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding BoundGameCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
                                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="9,5" Margin="4,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="未绑定" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding UnboundGameCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
                                    </Grid>
                                    <StackPanel Grid.Row="2"><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="绑定覆盖率" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9"/><TextBlock Grid.Column="1" Text="{Binding GameBindingCoverageText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding GameBindingCoverage, Mode=OneWay}" Height="5" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource AccentBrush}"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" CornerRadius="2.5" ClipToBounds="True"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2.5" HorizontalAlignment="Left"/></Grid></Border></ControlTemplate></ProgressBar.Template></ProgressBar></StackPanel>
                                </Grid>
                            </Border>

                            <!-- Steam 库快捷启动 -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="11" Background="#332D7DFF" Margin="0,0,11,0"><TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF75B7FF" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Steam 库快捷启动" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="在库页面切换账号并启动" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="0,3,0,0"/></StackPanel>
                                        <Border Grid.Column="2" CornerRadius="8" Padding="8,4" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsInjectorConnected}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding InjectorStateText}" FontSize="9" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsInjectorConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="9,6" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding InjectorStatusDescription}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Grid></Border>
                                    <StackPanel Grid.Row="2" Margin="0,4" VerticalAlignment="Center"><Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SuccessFgBrush}" FontSize="10" Margin="0,0,7,0"/><TextBlock Grid.Column="1" Text="库页面直接选择账号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FFFFB454" FontSize="10" Margin="0,0,7,0"/><TextBlock Grid.Column="1" Text="会启用本地 CEF 调试端口" Foreground="#FFFFB454" FontSize="9"/></Grid></StackPanel>
                                    <Button Grid.Row="3" Command="{Binding StartInjectorCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" Style="{StaticResource PrimaryBtn}" Height="32"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="连接 Steam 库" FontSize="11" FontWeight="SemiBold"/></StackPanel></Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
 
                        <!-- 游戏视图 -->
                        <Grid x:Name="GameView" Visibility="Collapsed" Style="{StaticResource FadeInUpViewStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

                            <!-- 左侧：游戏列表 -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="13"/>
                                            <TextBox Grid.Column="1" x:Name="GameSearchBox" Text="搜索游戏、AppID 或启动账号..." Background="Transparent" Foreground="{DynamicResource SearchPlaceholderFgBrush}" BorderThickness="0" CaretBrush="{DynamicResource TextPrimaryBrush}" FontSize="13" Padding="2,0" VerticalAlignment="Center"
                                                      TextChanged="GameSearchBox_TextChanged" GotFocus="GameSearchBox_GotFocus" LostFocus="GameSearchBox_LostFocus"/>
                                            <Button Grid.Column="2" x:Name="GameClearSearch" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="24" Height="24" FontSize="10" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="GameClearSearch_Click" Visibility="Collapsed">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="cb" Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="1" Content="扫描" Click="GameScan_Click" Width="72" Height="38" Style="{StaticResource PrimaryBtn}"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="2,0,2,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GameScanStatus" Text="已安装游戏" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="选择游戏后绑定启动账号" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Grid.Row="2" Background="{DynamicResource CardBgAltBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <ListBox x:Name="GameListBox" ItemsSource="{Binding GameList}" SelectedItem="{Binding SelectedGame}"
                                                 Background="Transparent" BorderThickness="0" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource GameListItemStyle}"
                                                 ItemTemplate="{StaticResource GameItemTemplate}"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.CanContentScroll="True"/>
                                        <TextBlock x:Name="GameEmptyHint" Text="点击 [扫描] 加载本地 Steam 游戏" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>


                                <Button Grid.Row="3" Content="+ 手动添加游戏" Click="ManualAddToggle_Click" Margin="0,8,0,0" Height="34" Style="{StaticResource SecondaryBtn}"/>

                                <!-- 手动添加面板 -->
                                <Border Grid.Row="4" x:Name="ManualAddPanel" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="12,10"
                                        Margin="0,8,0,0" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="96"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="AppID" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" x:Name="ManualAppId" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="7,5" FontSize="12" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="游戏名" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="3" x:Name="ManualGameName" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="7,5" FontSize="12" Margin="0,0,10,0"/>
                                        <Button Grid.Column="4" Content="添加" Click="ManualAddBinding_Click" Width="58" Height="30" Style="{StaticResource PrimaryBtn}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 右侧：绑定面板 -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                        <TextBlock Text="绑定设置" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="为游戏指定启动前切换的 Steam 账号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="{DynamicResource CardBgAltBrush}" CornerRadius="11" Padding="13" Margin="0,0,0,12"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBgBrush}" Margin="0,0,11,0">
                                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedGameName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SelectedGameAppId, StringFormat='AppID {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="1" CornerRadius="9" Padding="10,8" Margin="0,12,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedGameHasBinding}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/><Setter Property="BorderBrush" Value="#6634C759"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,9,0">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameHasBinding}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="当前启动账号" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9"/>
                                                        <TextBlock Text="{Binding SelectedGameBindingAccount}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameHasBinding}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding SelectedGameBindingTime, StringFormat='最后启动 · {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="选择启动账号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="点击账号后保存" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9"/>
                                    </Grid>
                                    <ListBox Grid.Row="3" x:Name="GameAccountList" ItemsSource="{Binding Accounts}"
                                             SelectedItem="{Binding SelectedBindingAccount}" Background="Transparent"
                                             BorderThickness="0" Margin="0,0,0,12" Padding="4">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                            <Setter Property="Height" Value="50"/><Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                                <Border CornerRadius="8" Margin="0,2" x:Name="abi"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="0" Y="0" x:Name="trans"/>
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0" x:Name="shadow"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Border CornerRadius="8" Background="{DynamicResource HoverBgBrush}" Opacity="0" x:Name="hoverBg"/>
                                                        <Border CornerRadius="8" Background="{DynamicResource SelectedBgBrush}" Opacity="0" x:Name="selectBg">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#0084FF" BlurRadius="10" ShadowDepth="0" Opacity="0.25"/>
                                                            </Border.Effect>
                                                        </Border>
                                                        <Grid Margin="9,0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AvatarBgBrush}" VerticalAlignment="Center">
                                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/></Image.Clip></Image>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                 <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                 <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" 
                                                                    Style="{StaticResource StatusBadgeStyle}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="当前" Foreground="#30D158" FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="trans" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="trans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="4" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="selectBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="selectBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate></Setter.Value></Setter>
                                        </Style></ListBox.ItemContainerStyle>
                                    </ListBox>

                                    <StackPanel Grid.Row="4">
                                        <Button Content="保存绑定" Click="GameSaveBinding_Click" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,8"/>
                                        <Button Content="删除绑定" Click="GameRemoveBinding_Click" Height="36" Style="{StaticResource DangerBtn}" Margin="0,0,0,8"
                                                Visibility="{Binding SelectedGameHasBinding, Converter={StaticResource BoolToVis}}"/>
                                        <ToggleButton x:Name="GamePinToggle" IsChecked="{Binding SelectedGame.IsPinned, Mode=OneWay, FallbackValue=False}"
                                                      Click="GamePinToggle_Click" Height="34" Cursor="Hand" HorizontalAlignment="Center">
                                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{DynamicResource ToggleBgBrush}" CornerRadius="9" Width="128" Height="34" x:Name="pb">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="pi" Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Opacity="0.45"/>
                                                        <TextBlock x:Name="pt" Text="固定到任务栏" FontSize="12" Foreground="#8E8E96" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pb" Property="Background" Value="{DynamicResource ToggleHoverBgBrush}"/><Setter TargetName="pi" Property="Opacity" Value="0.7"/></Trigger>
                                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="pi" Property="Opacity" Value="1"/><Setter TargetName="pi" Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="pt" Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate></ToggleButton.Template>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 快速启动视图 -->
                        <Grid x:Name="QuickLaunchView" Visibility="Collapsed" Style="{StaticResource FadeInUpViewStyle}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 
                            <!-- 顶部：添加按钮 -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="快速启动项" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="添加程序或快捷方式" Click="QuickLaunchAdd_Click" Style="{StaticResource SecondaryBtn}" Padding="14,0" Height="34" FontSize="12"/>
                            </Grid>
 
                            <!-- 删除区域 -->
                            <Border x:Name="QuickLaunchDeleteZone" Grid.Row="0" Background="#CCFF453A" CornerRadius="8" Margin="0,0,0,4" Padding="12,8"
                                    Visibility="Collapsed" HorizontalAlignment="Stretch" Height="48">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="拖到此处删除" Foreground="White" FontSize="13"/></StackPanel>
                            </Border>
 
                            <!-- 列表 -->
                            <Border Grid.Row="2" Background="{DynamicResource CardBgAltBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                                <Grid>
                                    <ListBox x:Name="QuickLaunchListBox" ItemsSource="{Binding QuickLaunchList}"
                                             Background="Transparent" BorderThickness="0" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemTemplate="{DynamicResource QuickLaunchItemTemplate}"
                                             ItemContainerStyle="{StaticResource QuickLaunchListItemStyle}"
                                             VirtualizingStackPanel.IsVirtualizing="True"
