                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="selectBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- 页面切换渐入和向上滑入过渡动效 -->
        <Style x:Key="FadeInUpViewStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Collapsed">
                    <Setter Property="Opacity" Value="0"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Visibility, RelativeSource={RelativeSource Self}}" Value="Visible"/>
                        <Condition Binding="{Binding DataContext.MinimalMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 圆角调整大小手柄 -->
        <Style TargetType="ResizeGrip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ResizeGrip">
                        <Grid Background="Transparent" Width="16" Height="16">
                            <Path Data="M8,14 L14,8 M11,14 L14,11 M14,14 L14,14" 
                                  Stroke="{DynamicResource TextTertiaryBrush}" 
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right" 
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,2,2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 苹果风格侧边栏按钮样式 -->
        <Style x:Key="AppleSidebarBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarInactiveFgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 苹果风格 12px 圆角胶囊容器 -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" x:Name="b" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="sidebarShadow" Color="#0084FF" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停时如果是未选中状态，显示轻微悬浮灰 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Background" Value="Transparent"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </MultiTrigger>
                            
                            <!-- 悬停缩放动画 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- 点击按压收缩动画 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- 选中态（FontWeight为SemiBold时）冰蓝色呼吸外发光阴影 -->
                            <Trigger Property="FontWeight" Value="SemiBold">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sidebarShadow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="sidebarShadow" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sidebarShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="sidebarShadow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" ClipToBounds="True" SnapsToDevicePixels="True" RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- 窗口底部星光溢光背景层 (极轻度发光叠加) -->
            <Border Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.12" CornerRadius="20" ClipToBounds="True">
                <Border.Background>
                    <RadialGradientBrush Center="0.85,0.15" GradientOrigin="0.85,0.15" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#007AFF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.07" CornerRadius="20" ClipToBounds="True">
                <Border.Background>
                    <RadialGradientBrush Center="0.15,0.85" GradientOrigin="0.15,0.85" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#5856D6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- 品牌标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}" Padding="0">
                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左侧：品牌 Logo 与名称 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentBgBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Margin="0,0,11,0">
                            <Image Source="pack://application:,,,/SteamSwitch;component/Resources/icon.png" Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Steam Switch" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="多账号管理中心" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 中间：面包屑导航 (Steam Switch / 当前页面) -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Steam Switch" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text=" / " FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0"/>
                            <TextBlock Text="{Binding Text, ElementName=PageTitle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 右侧：Steam 运行状态徽章与窗口控制按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="6" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                </Border>
                                <TextBlock Text="STEAM" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnWindow}" Command="{Binding RefreshCommand}" ToolTip="刷新" Width="40" Height="56"/>
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnWindow}" Click="Minimize_Click" ToolTip="最小化" Width="44" Height="56"/>
                        <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnWindow}" Click="Maximize_Click" ToolTip="最大化/还原" Width="44" Height="56"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BtnClose}" Click="Close_Click" ToolTip="关闭" Width="48" Height="56"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="0" Height="0.5" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>

            <!-- 主体 (左右分栏，侧边栏通底) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：全局侧边栏 (Apple / Fluent 优雅分组) -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
                    <DockPanel Margin="12,12,12,14" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <!-- 分组 1: LIBRARY -->
                            <TextBlock Text="LIBRARY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,6,10,5"/>
                            <!-- 账号 -->
                            <Grid Margin="0,0,0,4">
                                <Border x:Name="SideAccentAccount" Width="3" Height="18" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button x:Name="SideAccounts" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideAccounts_Click" ToolTip="账号管理与一键切换">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="账号管理" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <!-- 游戏 -->
                            <Grid Margin="0,0,0,4">
                                <Border x:Name="SideAccentGame" Width="3" Height="18" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button x:Name="SideGames" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideGames_Click" ToolTip="Steam 游戏库与账号绑定">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="游戏绑定" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 存档中心 -->
                            <Grid Margin="0,0,0,4">
                                <Border x:Name="SideAccentSave" Width="3" Height="18" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button x:Name="SideSaveCenter" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideSaveCenter_Click" ToolTip="游戏存档备份与同步中心">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="游戏存档" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <!-- 快捷启动 -->
                            <Grid Margin="0,0,0,8">
                                <Border x:Name="SideAccentQuickLaunch" Width="3" Height="18" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button x:Name="SideQuickLaunch" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideQuickLaunch_Click" ToolTip="快捷启动面板">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="快捷启动" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 分组 2: SYSTEM -->
                            <TextBlock Text="SYSTEM" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,8,10,5"/>

                            <!-- 透明任务栏 -->
                            <Grid Margin="0,0,0,4">
                                <Border x:Name="SideAccentTransparentTaskbar" Width="3" Height="18" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button x:Name="SideTransparentTaskbar" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideTransparentTaskbar_Click" ToolTip="任务栏透明与磨砂亚克力美化">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="透明任务栏" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 任务栏歌词 -->
                            <Grid Margin="0,0,0,4">
                                <Border x:Name="SideAccentTaskbarLyrics" Width="3" Height="18" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button x:Name="SideTaskbarLyrics" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideTaskbarLyrics_Click" ToolTip="任务栏滚动歌词与音乐控制">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="任务栏歌词" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 侧边栏底部：设置、Mini-Account 状态卡片、版本信息 -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <!-- 设置 -->
                            <Grid Margin="0,0,0,6">
                                <Border x:Name="SideAccentSettings" Width="3" Height="18" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button x:Name="SideSettings" Style="{StaticResource AppleSidebarBtnStyle}" Click="SideSettings_Click" ToolTip="偏好设置">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="偏好设置" FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Mini-Account 状态卡片 -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="9,8" Margin="0,4,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AvatarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding CurrentAccountViewModel.Avatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentAccountViewModel.Avatar}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentAccountViewModel.DisplayName, TargetNullValue=未登录, FallbackValue=未登录}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SteamStatusText, FallbackValue='Steam 未运行'}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9.5" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="6" Height="6" CornerRadius="2" VerticalAlignment="Center" Margin="3,0,2,0">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 版本号 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Border Width="5" Height="5" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CompactVersionText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9.5"/>
                                <TextBlock Text=" · 已是最新版本" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9.5"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                
                <!-- 侧边栏与内容分割线 -->
                <Border Grid.Column="0" Width="0.5" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Right"/>

                <!-- 右侧：主内容区 -->
                <Grid Grid.Column="1" Margin="28,20,28,22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="PageHeader" Grid.Row="0" Margin="2,0,2,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Text="账号管理" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock x:Name="PageSubtitle" Text="双击卡片快速切换 Steam 身份，支持置顶常用账号。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="6" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSteamRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessFgBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                </Border>
                                <TextBlock Text="{Binding SteamStateText, StringFormat=Steam {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1">
                    <!-- 账号视图 (Apple Concept Layout) -->
                    <!-- 固定工作台：整页不滚动，账号过多时仅在账号列表区域内滚动。 -->
                    <Grid x:Name="AccountView" Style="{StaticResource FadeInUpViewStyle}" Margin="0,0,10,0" ClipToBounds="True">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="24,18" Margin="0,0,0,16">
                            <StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="账号管理" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="30" FontWeight="Bold"/>
                                <TextBlock Text="管理您的 Steam 账号与本地数据" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                            <!-- 工具栏：搜索、筛选和展示方式收在同一行。 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="144"/>
                                    <ColumnDefinition Width="164"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Height="46" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="AccountSearchBox" Text="搜索账号名称或登录名..." Background="Transparent" BorderThickness="0" Padding="0,0,12,0" VerticalContentAlignment="Center" FontSize="14"
                                                 TextChanged="AccountSearchBox_TextChanged" GotFocus="AccountSearchBox_GotFocus" LostFocus="AccountSearchBox_LostFocus"/>
                                    </Grid>
                                </Border>
                                <Button x:Name="AccountFilterButton" Grid.Column="1" Style="{StaticResource SecondaryBtn}" Height="46" Margin="0,0,12,0" ToolTip="筛选账号" Click="AccountFilterButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="全部账号" Tag="All" Click="AccountFilterOption_Click"/>
                                            <MenuItem Header="当前账号" Tag="Current" Click="AccountFilterOption_Click"/>
                                            <MenuItem Header="已固定账号" Tag="Pinned" Click="AccountFilterOption_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="AccountFilterText" Text="全部账号" FontSize="12.5"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="10,0,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="AccountSortButton" Grid.Column="2" Style="{StaticResource SecondaryBtn}" Height="46" Margin="0,0,12,0" ToolTip="更改账号排序" Click="AccountSortButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="最近登录" Tag="Recent" Click="AccountSortOption_Click"/>
                                            <MenuItem Header="账号名称" Tag="Name" Click="AccountSortOption_Click"/>
                                            <MenuItem Header="固定优先" Tag="Pinned" Click="AccountSortOption_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="AccountSortText" Text="排序：最近登录" FontSize="12.5"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="10,0,0,0"/></StackPanel>
                                </Button>
                                <Border Grid.Column="4" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Height="46" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AccountListViewButton" Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" ToolTip="列表视图" Cursor="Hand" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SelectedBgBrush}" BorderThickness="0" Width="38" Height="36" Click="AccountListView_Click"/>
                                        <Button x:Name="AccountGridViewButton" Content="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="15" ToolTip="网格视图" Cursor="Hand" Foreground="{DynamicResource TextSecondaryBrush}" Background="Transparent" BorderThickness="0" Width="38" Height="36" Click="AccountGridView_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Stat Grid (4 个指标卡片) - Apple/GitHub 风格彩色图标徽章 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 本机账号 -->
                                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,14" Margin="0,0,8,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#192435" BlurRadius="14" ShadowDepth="1" Opacity="0.06"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="34" Height="34" CornerRadius="10" Background="#1A0A84FF" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#FF0A84FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="本机账号" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding AccountCountText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <!-- 当前登录 -->
                                <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,14" Margin="4,0,4,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#192435" BlurRadius="14" ShadowDepth="1" Opacity="0.06"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="34" Height="34" CornerRadius="10" Background="#1A30D158" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE7EE;" FontFamily="Segoe MDL2 Assets" Foreground="#FF30D158" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="当前登录" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding CurrentAccountViewModel.DisplayName, TargetNullValue=未登录, FallbackValue=未登录}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <!-- 已绑定游戏 -->
                                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,14" Margin="4,0,4,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#192435" BlurRadius="14" ShadowDepth="1" Opacity="0.06"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="34" Height="34" CornerRadius="10" Background="#1AFF9F0A" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="#FFFF9F0A" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="已绑定游戏" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding BoundGameCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <!-- Steam 状态 -->
                                <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,14" Margin="8,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#192435" BlurRadius="14" ShadowDepth="1" Opacity="0.06"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1A8E8E93"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
                                                                <Setter Property="Background" Value="#1A34C759"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xE7F5;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FF8E8E93"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FF34C759"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="Steam 状态" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SteamStateText}" FontSize="17" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Width="6" Height="6" CornerRadius="2" Margin="7,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessFgBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Account workbench: list on the left, selected-account details on the right. -->
                            <Grid x:Name="AccountWorkbench" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel x:Name="AccountListPanel" Grid.Column="0" Margin="0,0,24,0">
                                    <Grid Margin="2,4,2,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
                                            <TextBlock Text="我的账号" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="单击选择 · 双击切换" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ListBox x:Name="AccountListBox" ItemsSource="{Binding Source={StaticResource FilteredAccounts}}" SelectedItem="{Binding SelectedAccount}"
                                             Style="{StaticResource AccountList}" ItemTemplate="{StaticResource AccountItem}" MaxHeight="270" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="AccountListBox_MouseDoubleClick"/>
                                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryBtn}" Height="46" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="添加或重新扫描账号" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <Border x:Name="AccountDetailPanel" Grid.Column="1" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20" MinHeight="390">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="60" Height="60" CornerRadius="16" Background="{DynamicResource AvatarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,14,0">
                                                <Grid><Image Source="{Binding SelectedAccount.Avatar}" Stretch="UniformToFill"/><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedAccount.DisplayName, TargetNullValue=选择一个账号}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SelectedAccount.Username, StringFormat=Steam ID · {0}, TargetNullValue=Steam ID · -}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource SuccessBgBrush}" CornerRadius="9" Padding="9,5" VerticalAlignment="Center">
                                                <TextBlock Text="当前选择" Foreground="{DynamicResource SuccessFgBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20,0,18"/>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="账号概览" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="登录状态" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/><TextBlock Text="{Binding SteamStateText}" Foreground="{DynamicResource SuccessFgBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="最近登录" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedAccount.LastLoginText, TargetNullValue=暂无记录}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                            </Grid>
                                            <Border Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,20,0,0">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="已绑定游戏" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="可前往游戏库为此账号配置启动规则" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding BoundGameCount}" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></Grid>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Margin="0,22,0,0">
                                            <Button Command="{Binding SwitchAndLaunchCommand}" Style="{StaticResource PrimaryBtn}" Height="46"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="切换并启动 Steam" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
                                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Click="SideSaveCenter_Click" Style="{StaticResource SecondaryBtn}" Height="40" Margin="0,0,5,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="查看存档" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/></StackPanel></Button><Button Grid.Column="1" Click="CreateAccountShortcut_Click" Style="{StaticResource SecondaryBtn}" Height="40" Margin="5,0,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="创建桌面快捷方式" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/></StackPanel></Button></Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                        <!-- 游戏视图 -->
                        <Grid x:Name="GameView" Visibility="Collapsed" Style="{StaticResource FadeInUpViewStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

                            <!-- 左侧：游戏列表 -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" Padding="13,0" Height="48" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="13.5"/>
                                            <TextBox Grid.Column="1" x:Name="GameSearchBox" Text="搜索游戏、AppID 或启动账号..." Background="Transparent" Foreground="{DynamicResource SearchPlaceholderFgBrush}" BorderThickness="0" CaretBrush="{DynamicResource TextPrimaryBrush}" FontSize="14" Padding="2,0" VerticalAlignment="Center"
                                                      TextChanged="GameSearchBox_TextChanged" GotFocus="GameSearchBox_GotFocus" LostFocus="GameSearchBox_LostFocus"/>
                                            <Button Grid.Column="2" x:Name="GameClearSearch" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="24" Height="24" FontSize="10" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="GameClearSearch_Click" Visibility="Collapsed">
                                                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="cb" Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="1" Click="GameScan_Click" Width="104" Height="48" Style="{StaticResource PrimaryBtn}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="扫描游戏" FontSize="12.5" FontWeight="SemiBold"/></StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1" Margin="2,0,2,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GameScanStatus" Text="已安装游戏" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="选择游戏后绑定启动账号" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Background="{DynamicResource CardBgAltBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <ListBox x:Name="GameListBox" ItemsSource="{Binding GameList}" SelectedItem="{Binding SelectedGame}"
                                                 Background="Transparent" BorderThickness="0" Padding="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource GameListItemStyle}"
                                                 ItemTemplate="{StaticResource GameItemTemplate}"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.CanContentScroll="True"/>
                                        <TextBlock x:Name="GameEmptyHint" Text="点击 [扫描] 加载本地 Steam 游戏" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>

                                <Button Grid.Row="3" Click="ManualAddToggle_Click" Margin="0,10,0,0" Height="44" Style="{StaticResource SecondaryBtn}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="手动添加游戏" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/></StackPanel></Button>

                                <!-- 手动添加面板 -->
                                <Border Grid.Row="4" x:Name="ManualAddPanel" Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14,12"
                                        Margin="0,8,0,0" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="104"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="AppID" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" x:Name="ManualAppId" Height="42" Style="{StaticResource FormTextBoxStyle}" FontSize="13" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="游戏名" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="3" x:Name="ManualGameName" Height="42" Style="{StaticResource FormTextBoxStyle}" FontSize="13" Margin="0,0,12,0"/>
                                        <Button Grid.Column="4" Content="添加" Click="ManualAddBinding_Click" Width="74" Height="42" Style="{StaticResource PrimaryBtn}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 右侧：绑定面板 -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="18" Padding="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#192435" BlurRadius="14" ShadowDepth="1" Opacity="0.05"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <!-- 顶部彩色标题条 -->
                                    <Border Grid.Row="0" Background="{DynamicResource AccentBgBrush}" CornerRadius="18,18,0,0" Padding="18,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}" Margin="0,0,13,0">
                                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="绑定设置" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
