                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </DataTemplate>

                        <DataTemplate x:Key="GameItemTemplate">
                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" Padding="14,12" Margin="0,4"
