                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="9" Padding="10,6" Margin="10,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBgAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
