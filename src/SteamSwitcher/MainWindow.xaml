                                                            <Border x:Name="rb" CornerRadius="9" Padding="4,7" Background="Transparent">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" x:Name="ico"/>
                                                                    <TextBlock Text="全透" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}" x:Name="lbl"/>
