                                                                        <Border Width="1.7" Height="3.2" CornerRadius="0.85" Margin="0.55,0" VerticalAlignment="Center" Background="#FF38F9D7"/>
                                                                        <Border Width="1.7" Height="5.2" CornerRadius="0.85" Margin="0.55,0" VerticalAlignment="Center" Background="#FF64D2FF"/>
