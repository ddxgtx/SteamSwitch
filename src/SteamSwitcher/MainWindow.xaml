                                            </Button>
                                            <Button Tag="Acrylic:45:#000000" Click="TaskbarStylePreset_Click" Style="{StaticResource SecondaryBtn}" Height="58" Margin="4" Padding="10,0">
                                                <StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="8" Background="#EEE9FF" Margin="0,0,8,0"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Foreground="#7655D9" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="磨砂亚克力" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="透明度 45%" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel>
                                            </Button>
                                            <Button Tag="Acrylic:70:#000000" Click="TaskbarStylePreset_Click" Style="{StaticResource SecondaryBtn}" Height="58" Margin="4" Padding="10,0">
                                                <StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="8" Background="#E9EBF0" Margin="0,0,8,0"><TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" Foreground="#222936" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="暗夜深黑" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="透明度 70%" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel>
                                            </Button>
                                            <Button Tag="Acrylic:55:#07182F" Click="TaskbarStylePreset_Click" Style="{StaticResource SecondaryBtn}" Height="58" Margin="4" Padding="10,0">
                                                <StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="8" Background="#E7EEFA" Margin="0,0,8,0"><TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" Foreground="#315C9B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="雅致蓝黑" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="透明度 55%" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel>
                                            </Button>
                                            <Button Tag="Acrylic:65:#171D25" Click="TaskbarStylePreset_Click" Style="{StaticResource SecondaryBtn}" Height="58" Margin="4" Padding="10,0">
                                                <StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="8" Background="#E5F0F8" Margin="0,0,8,0"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="#1B689A" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Steam 经典" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="透明度 65%" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel>
                                            </Button>
                                            <Button Tag="Acrylic:50:#202124" Click="TaskbarStylePreset_Click" Style="{StaticResource SecondaryBtn}" Height="58" Margin="4" Padding="10,0">
                                                <StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="8" Background="#EEF0F2" Margin="0,0,8,0"><TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" Foreground="#59616D" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="石墨素雅" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="透明度 50%" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/></StackPanel></StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- 颜色与不透明度 -->
                                <Border IsEnabled="{Binding TaskbarAppearanceEnabled}" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="0,12,0,0" Padding="20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentBgBrush}" Margin="0,0,11,0"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="自定义外观" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="设置叠加颜色与透明度，打造专属任务栏氛围" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="10,7" Margin="0,0,10,0">
                                                <StackPanel><TextBlock Text="十六进制颜色" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,0,0,3"/><TextBox x:Name="TaskbarAppearanceColorBox" Height="30" Padding="3,0" BorderThickness="0" Background="Transparent" FontSize="12" FontWeight="SemiBold" Text="{Binding TaskbarAppearanceColor}" LostFocus="TaskbarAppearanceColor_LostFocus" MaxLength="7"/></StackPanel>
                                            </Border>
                                            <UniformGrid Grid.Column="1" Columns="4">
                                                <Button Tag="#000000" Click="TaskbarAppearanceColorPreset_Click" Style="{StaticResource SecondaryBtn}" Height="54" Margin="0,0,5,0"><StackPanel><Border Width="17" Height="17" CornerRadius="8.5" Background="#000000" HorizontalAlignment="Center"/><TextBlock Text="深黑" FontSize="9.5" Margin="0,4,0,0"/></StackPanel></Button>
                                                <Button Tag="#07182F" Click="TaskbarAppearanceColorPreset_Click" Style="{StaticResource SecondaryBtn}" Height="54" Margin="2,0"><StackPanel><Border Width="17" Height="17" CornerRadius="8.5" Background="#07182F" HorizontalAlignment="Center"/><TextBlock Text="蓝黑" FontSize="9.5" Margin="0,4,0,0"/></StackPanel></Button>
                                                <Button Tag="#202124" Click="TaskbarAppearanceColorPreset_Click" Style="{StaticResource SecondaryBtn}" Height="54" Margin="2,0"><StackPanel><Border Width="17" Height="17" CornerRadius="8.5" Background="#202124" HorizontalAlignment="Center"/><TextBlock Text="石墨" FontSize="9.5" Margin="0,4,0,0"/></StackPanel></Button>
                                                <Button Tag="#171D25" Click="TaskbarAppearanceColorPreset_Click" Style="{StaticResource SecondaryBtn}" Height="54" Margin="5,0,0,0"><StackPanel><Border Width="17" Height="17" CornerRadius="8.5" Background="#171D25" HorizontalAlignment="Center"/><TextBlock Text="Steam" FontSize="9.5" Margin="0,4,0,0"/></StackPanel></Button>
                                            </UniformGrid>
                                        </Grid>
                                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="13,10">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="透明度" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><Slider x:Name="TaskbarAppearanceOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="45" TickFrequency="5" ValueChanged="TaskbarAppearanceOpacity_ValueChanged" VerticalAlignment="Center"/><Border Grid.Column="2" Background="{DynamicResource AccentBgBrush}" CornerRadius="8" Padding="7,4" Margin="10,0,0,0"><TextBlock x:Name="TaskbarAppearanceOpacityText" Text="45%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 右栏：多场景智能动态适配与保护 -->
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <Border IsEnabled="{Binding TaskbarAppearanceEnabled}" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentBgBrush}" Margin="0,0,10,0"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="行为与场景保护" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="根据窗口状态自动平衡透明效果与可读性" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid>
                                        <!-- 1. 窗口最大化 -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="窗口最大化时自动切换纯色" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/>
                                                <TextBlock Text="按当前屏幕独立检测，防止壁纸干扰最大化窗口" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding TaskbarDynamicMaximized}" Checked="TaskbarAppearance_Changed" Unchecked="TaskbarAppearance_Changed" Style="{StaticResource SwitchToggle}"/>
                                        </Grid>

                                        <!-- 2. 打开开始菜单 -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="打开开始菜单时恢复系统样式" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/>
                                                <TextBlock Text="呼出 Windows 开始菜单时保持系统原生合成" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding TaskbarDynamicStartMenu}" Checked="TaskbarAppearance_Changed" Unchecked="TaskbarAppearance_Changed" Style="{StaticResource SwitchToggle}"/>
                                        </Grid>

                                        <!-- 3. 打开 Windows 搜索 -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="聚焦系统搜索时恢复系统样式" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/>
                                                <TextBlock Text="弹出搜索面板时保持背景纯净，提升结果可读性" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding TaskbarDynamicSearch}" Checked="TaskbarAppearance_Changed" Unchecked="TaskbarAppearance_Changed" Style="{StaticResource SwitchToggle}"/>
                                        </Grid>

                                        <!-- 4. 打开任务视图/时间线 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="呼出多任务视图时保持半透" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/>
                                                <TextBlock Text="Win+Tab 视图下使用半透明分层合成" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding TaskbarDynamicTaskView}" Checked="TaskbarAppearance_Changed" Unchecked="TaskbarAppearance_Changed" Style="{StaticResource SwitchToggle}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource AccentBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="一键深度全透明" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="采用 DWM 核心层穿透技术，一键实现任务栏 100% 极净全透" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" LineHeight="15" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="BtnStartXamlEnhancer" Click="TaskbarAppearanceStartXamlEnhancer_Click" Style="{StaticResource PrimaryBtn}" Height="36" MinWidth="112" Padding="14,0" VerticalAlignment="Center" AutomationProperties.Name="一键开启任务栏全透明"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0"/><TextBlock Text="立即全透明" FontSize="10.5"/></StackPanel></Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 桌面图标智能隐藏：所有开关直接由 DesktopIconService 监听并持久化 -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentBgBrush}" Margin="0,0,11,0">
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="桌面图标智能隐藏" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="自动收起桌面图标，保持壁纸与桌面空间清爽。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding DesktopAutoHideIconsEnabled}" Checked="DesktopEnhance_Changed" Unchecked="DesktopEnhance_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>

                                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DesktopIconStatusText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding DesktopAutoHideCountdownText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9.5" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="实时生效" Foreground="{DynamicResource SuccessFgBrush}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border>
                                        <StackPanel Margin="0,0,0,12" IsEnabled="{Binding DesktopAutoHideIconsEnabled}">
                                            <Border MinHeight="64" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE8B0;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center"><TextBlock Text="单击手动隐藏/取消隐藏" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="单击桌面空白处即可在隐藏与显示之间切换" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding DesktopToggleIconsOnClick}" Checked="DesktopEnhance_Changed" Unchecked="DesktopEnhance_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border MinHeight="64" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE8B2;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center"><TextBlock Text="移动鼠标恢复桌面图标" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="图标隐藏后，在桌面移动鼠标即可恢复" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding DesktopRestoreByMouseMove}" Checked="DesktopEnhance_Changed" Unchecked="DesktopEnhance_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border MinHeight="64" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center"><TextBlock Text="单击任务栏恢复桌面图标" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="图标隐藏后，单击任意任务栏区域即可恢复" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding DesktopRestoreByTaskbarClick}" Checked="DesktopEnhance_Changed" Unchecked="DesktopEnhance_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
<StackPanel Visibility="{Binding DesktopAutoHideIconsEnabled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="隐藏方式" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,7"/>
                                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                                <RadioButton x:Name="DesktopModeSmart" GroupName="DesktopHideMode" Tag="Smart" Checked="DesktopHideMode_Changed" Margin="0,0,5,0"><RadioButton.Content><StackPanel><TextBlock Text="智能模式" FontWeight="SemiBold" FontSize="10.5"/><TextBlock Text="桌面鼠标静止" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></RadioButton.Content></RadioButton>
                                                <RadioButton x:Name="DesktopModeTimed" GroupName="DesktopHideMode" Tag="Timed" Checked="DesktopHideMode_Changed" Margin="3,0"><RadioButton.Content><StackPanel><TextBlock Text="定时隐藏" FontWeight="SemiBold" FontSize="10.5"/><TextBlock Text="固定延迟" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></RadioButton.Content></RadioButton>
                                                <RadioButton x:Name="DesktopModeManual" GroupName="DesktopHideMode" Tag="Manual" Checked="DesktopHideMode_Changed" Margin="5,0,0,0"><RadioButton.Content><StackPanel><TextBlock Text="手动模式" FontWeight="SemiBold" FontSize="10.5"/><TextBlock Text="仅快捷操作" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></RadioButton.Content></RadioButton>
                                            </UniformGrid>
                                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="隐藏延迟" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><Slider Minimum="5" Maximum="300" Value="{Binding DesktopIconIdleSeconds, UpdateSourceTrigger=PropertyChanged}" ValueChanged="DesktopEnhance_Changed" Margin="0,6,12,0" IsSnapToTickEnabled="True" TickFrequency="5"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource AccentBgBrush}" CornerRadius="8" Padding="9,5" VerticalAlignment="Center"><TextBlock Text="{Binding DesktopIconIdleSeconds, StringFormat={}{0} 秒}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border></Grid>
                                            <WrapPanel Margin="0,0,0,11"><TextBlock Text="常用：" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><Button Content="5 秒" Tag="5" Click="DesktopDelayPreset_Click" Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" Margin="0,0,5,0"/><Button Content="10 秒" Tag="10" Click="DesktopDelayPreset_Click" Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" Margin="0,0,5,0"/><Button Content="30 秒" Tag="30" Click="DesktopDelayPreset_Click" Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" Margin="0,0,5,0"/><Button Content="1 分钟" Tag="60" Click="DesktopDelayPreset_Click" Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" Margin="0,0,5,0"/><Button Content="5 分钟" Tag="300" Click="DesktopDelayPreset_Click" Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0"/></WrapPanel>

                                        </StackPanel>

                                        <Border Background="{DynamicResource AccentBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="沉浸桌面模式" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="联动透明任务栏与桌面图标自动隐藏" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="进入沉浸模式" Click="DesktopImmersiveMode_Click" Style="{StaticResource PrimaryBtn}" Height="36" MinWidth="126" Padding="14,0" VerticalAlignment="Center" IsEnabled="{Binding DesktopAutoHideIconsEnabled}"/></Grid></Border>
                                        <UniformGrid Columns="3"><Button Content="立即隐藏" Click="DesktopHideNow_Click" Style="{StaticResource SecondaryBtn}" Height="32" Margin="0,0,5,0" IsEnabled="{Binding DesktopAutoHideIconsEnabled}"/><Button Content="立即显示" Click="DesktopShowNow_Click" Style="{StaticResource SecondaryBtn}" Height="32" Margin="2,0" IsEnabled="{Binding DesktopAutoHideIconsEnabled}"/><Button Content="恢复默认" Click="DesktopEnhanceReset_Click" Style="{StaticResource SecondaryBtn}" Height="32" Margin="5,0,0,0"/></UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>

                        <!-- 任务栏歌词视图 -->
                        <ScrollViewer x:Name="TaskbarLyricsView" Visibility="Collapsed" Style="{StaticResource FadeInUpViewStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
