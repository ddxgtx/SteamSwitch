                        <Border Background="{DynamicResource AccentBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="9,3" Margin="14,0,0,0" Cursor="Hand" MouseLeftButtonDown="GitHubLink_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="GitHub" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 加载遮罩 - 覆盖全窗口 -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Background="{DynamicResource WindowBgBrush}" Opacity="0.94" Grid.RowSpan="3">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 加载图标 -->
                    <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- 进度条 -->
                    <Border Width="140" Height="4" CornerRadius="2" Background="{DynamicResource InputBgBrush}" Margin="0,0,0,12">
                        <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"/>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- 调整大小手柄 -->
            <Thumb Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="20" Height="20" Margin="0,0,2,2" Cursor="SizeNWSE"
                   DragStarted="ResizeGrip_DragStarted"
                   DragDelta="ResizeGrip_DragDelta"
                   Background="Transparent">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Path Data="M4,16 L16,4 M10,16 L16,10 M16,16 L16,16" 
                                  Stroke="{DynamicResource TextTertiaryBrush}" 
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right" 
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,2,2"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
