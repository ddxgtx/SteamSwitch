                                            <StackPanel><TextBlock Text="任务栏歌词纵向微调" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/><Slider x:Name="TaskbarLyricsVerticalSlider" Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TaskbarLyricsVerticalOffset}" ValueChanged="TaskbarLyricsVertical_ValueChanged" Margin="0,4,14,0"/></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TaskbarLyricsVerticalOffset, StringFormat={}{0} px}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 歌词与时间轴 -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Height="12" Width="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="歌词与时间轴" Foreground="{DynamicResource SectionLabelBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid Margin="0,6,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="仅播放音乐时显示歌词" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/><TextBlock Text="与 Lyricify 一致：播放视频、图片等其他媒体时自动隐藏歌词" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding TaskbarLyricsMusicOnly}" Checked="TaskbarLyrics_Changed" Unchecked="TaskbarLyrics_Changed" Style="{StaticResource SwitchToggle}"/>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,12"/>
                                        <Grid Margin="0,6,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="长歌词自动拆分" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/><TextBlock Text="将过长歌词拆成两行，减少截断并保持歌词框稳定" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding LyricSplitLongLines}" Checked="TaskbarLyrics_Changed" Unchecked="TaskbarLyrics_Changed" Style="{StaticResource SwitchToggle}"/>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="歌词时间轴同步微调" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/>
                                                <TextBlock Text="歌词整体偏快或偏慢时，用它校准与播放进度的对齐" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0"/>
                                                <Slider x:Name="LyricOffsetSlider" Minimum="-3000" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding LyricOffsetMs}" ValueChanged="LyricOffsetSlider_ValueChanged" Margin="0,8,14,0" AutomationProperties.Name="歌词时间轴偏移"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LyricOffsetText" Grid.Column="1" Text="0 ms" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 性能与文字 -->
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Height="12" Width="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="性能与文字" Foreground="{DynamicResource SectionLabelBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid Margin="0,6,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="媒体刷新间隔（越低越流畅）" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/><Slider x:Name="TaskbarLyricsPollingSlider" Minimum="60" Maximum="500" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding TaskbarLyricsPollingIntervalMs}" ValueChanged="TaskbarLyricsPolling_ValueChanged" Margin="0,8,14,0" AutomationProperties.Name="媒体刷新间隔"/></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TaskbarLyricsPollingIntervalMs, StringFormat={}{0} ms}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="任务栏媒体主文字字号" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Medium"/><Slider Minimum="12" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TaskbarLyricsFontSize}" ValueChanged="TaskbarLyricsFontSize_ValueChanged" Margin="0,8,14,0" AutomationProperties.Name="任务栏媒体主文字字号"/></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TaskbarLyricsFontSize, StringFormat={}{0} px}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </Grid>
                                        <Button Content="恢复歌词显示默认设置" Click="ResetLyricsSettings_Click" Style="{StaticResource SecondaryBtn}" Height="32" HorizontalAlignment="Right" Padding="12,0" Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="QuickLaunchView" Visibility="Collapsed" Style="{StaticResource FadeInUpViewStyle}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 
                            <!-- 顶部：添加按钮与说明 -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentBgBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="快捷启动面板" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                                            <Border Background="{DynamicResource AccentBgBrush}" CornerRadius="8" Padding="7,3" Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QuickLaunchList.Count, StringFormat={}{0} 个项目}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="常用账号、游戏和程序的专属启动面板，支持拖拽排序与删除。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Click="QuickLaunchAdd_Click" Style="{StaticResource PrimaryBtn}" Height="40" MinWidth="184" Padding="16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="＋" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="添加程序或快捷方式" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="QuickLaunchAddFolder_Click" Style="{StaticResource SecondaryBtn}" Height="40" MinWidth="120" Margin="8,0,0,0" Padding="12,0" Content="添加文件夹"/>
                            </Grid>
 
                            <!-- 删除区域 -->
                            <Border x:Name="QuickLaunchDeleteZone" Grid.Row="1" Background="#CCFF453A" CornerRadius="10" Margin="0,0,0,8" Padding="12,8"
                                    Visibility="Collapsed" HorizontalAlignment="Stretch" Height="48">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="拖到此处直接删除项目" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
 
                            <!-- 列表 -->
                            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <ListBox x:Name="QuickLaunchListBox" ItemsSource="{Binding QuickLaunchList}"
                                             Background="Transparent" BorderThickness="0" Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemTemplate="{DynamicResource QuickLaunchItemTemplate}"
                                             ItemContainerStyle="{StaticResource QuickLaunchListItemStyle}"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                                    <StackPanel x:Name="QuickLaunchEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource AccentBgBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="还没有快捷启动项" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                        <TextBlock Text="把常用程序与游戏集中到一个入口，切换账号后也能随手启动。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="9,6" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="程序与快捷方式" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"/></StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="9,6" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE840;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="固定到快捷面板" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"/></StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="9,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="拖拽自由排序" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"/></StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="添加第一个项目" Click="QuickLaunchAdd_Click" Style="{StaticResource PrimaryBtn}" Width="140" Height="36" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14,10" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource AccentBgBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="整理你的启动顺序" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="拖拽项目调整位置；固定后可快速访问。" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="QuickLaunchAdd_Click" Style="{StaticResource SecondaryBtn}" Width="88" Height="32" Padding="10,0">
                                        <TextBlock Text="添加项目" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
 
                        <!-- 设置视图 -->
                        <Grid x:Name="SettingsView" Visibility="Collapsed" Style="{StaticResource FadeInUpViewStyle}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,6,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="SettingsCategoryHint" Text="常规设置 · 备份位置、启动行为、外观与通知" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="7" Padding="9,5" Margin="12,0,0,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasSettingsSaveError}" Value="True"><Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SettingsSaveStateLabel" Text="{Binding SettingsSaveStatusText}" ToolTip="{Binding SettingsSaveRecoveryHint}" FontSize="11" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasSettingsSaveError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        <Button x:Name="RetrySettingsSaveButton" Content="{Binding SettingsSaveActionText}" AutomationProperties.Name="{Binding SettingsSaveActionText}" Click="RetrySettingsSave_Click" Visibility="{Binding HasSettingsSaveError, Converter={StaticResource BoolToVis}}" Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" Margin="10,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TabControl x:Name="SettingsTabs" Grid.Row="1" Style="{StaticResource SettingsTabs}" SelectionChanged="SettingsTabs_SelectionChanged">
                                <TabItem x:Name="GeneralSettingsTab" Header="常规设置" Style="{StaticResource SettingsTab}" IsSelected="True">
                                    <ScrollViewer x:Name="GeneralSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="GeneralSettingsPanel">
                                            <Border x:Name="BackupExportSettingsCard" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,0,6,8">
                                                <StackPanel>
                                                    <TextBlock Text="备份保存位置" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="账号库、应用配置和存档导出默认保存在这里，按类型分类保留历史版本。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="BackupExportDirectoryBox" Text="{Binding BackupExportDirectoryDisplay, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="9,6" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,10,0" ToolTip="{Binding BackupExportDirectoryDisplay}" AutomationProperties.Name="备份导出目录"/>
                                                        <Button x:Name="SelectBackupExportDirectoryButton" Grid.Column="1" Content="更改目录" Click="SelectBackupExportDirectory_Click" IsEnabled="{Binding CanExportBackup}" Style="{StaticResource PrimaryBtn}" Height="34" Padding="16,0"/>
                                                    </Grid>
                                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="AskBeforeBackupExportCheckBox" Content="每次备份时询问保存位置" IsChecked="{Binding AskBeforeBackupExport}" IsEnabled="{Binding CanExportBackup}" Style="{StaticResource DialogCheckBoxStyle}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Content="打开目录" Click="OpenBackupExportDirectory_Click" Style="{StaticResource SecondaryBtn}" Height="28" Padding="10,0" Margin="0,0,6,0"/>
                                                            <Button Content="恢复默认" Click="ResetBackupExportDirectory_Click" IsEnabled="{Binding CanExportBackup}" Style="{StaticResource SecondaryBtn}" Height="28" Padding="10,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="关闭询问后，点击备份即可自动保存。游戏自动备份仓库可在存档中心查看。" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <Border x:Name="RecentBackupExportCard" Visibility="{Binding HasRecentBackupExport, Converter={StaticResource BoolToVis}}" Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="10,8" Margin="0,10,0,0">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RecentBackupExportSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                                <TextBlock x:Name="RecentBackupExportFileLabel" Text="{Binding RecentBackupExportFileName}" ToolTip="{Binding RecentBackupExportPath}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button x:Name="RevealRecentBackupExportButton" Content="定位文件" Click="RevealRecentBackupExport_Click" Style="{StaticResource SecondaryBtn}" Height="30" Padding="10,0" ToolTip="在文件资源管理器中选中最近导出的备份"/>
                                                                <Button Content="复制路径" Click="CopyRecentBackupExportPath_Click" Style="{StaticResource SecondaryBtn}" Height="30" Padding="10,0" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <!-- 常规与启动行为 -->
                                            <StackPanel Orientation="Horizontal" Margin="6,6,6,8">
                                                <Border Height="12" Width="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="常规与启动行为" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" Margin="0,0,6,12" Padding="0"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <!-- 开机自启 -->
                                                    <Border Padding="16,10" Style="{StaticResource SettingRowStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" CornerRadius="9" Background="#332D7DFF" Margin="0,0,11,0"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="#FF75B7FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="开机自动启动" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                                <TextBlock Text="登录 Windows 系统后自动在后台运行 SteamSwitch" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,14,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="2" IsChecked="{Binding StartWithWindows}" Checked="SettingsStartWithWindows_Changed" Unchecked="SettingsStartWithWindows_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <Border Background="{DynamicResource SeparatorBrush}" Height="0.5" Margin="14,0"/>

                                                    <!-- 切换后自动启动 Steam -->
                                                    <Border Padding="16,10" Style="{StaticResource SettingRowStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" CornerRadius="9" Background="#33007AFF" Margin="0,0,11,0"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="切换后自动启动 Steam" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                                <TextBlock Text="账号切换成功后自动拉起 Steam 客户端" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,14,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="2" IsChecked="{Binding AutoStartSteam}" Checked="SettingsAutoStartSteam_Changed" Unchecked="SettingsAutoStartSteam_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <Border Background="{DynamicResource SeparatorBrush}" Height="0.5" Margin="14,0"/>

                                                    <!-- 关闭时最小化到托盘 -->
                                                    <Border Padding="16,10" Style="{StaticResource SettingRowStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" CornerRadius="9" Background="#33FF9F43" Margin="0,0,11,0"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFB454" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="关闭窗口时最小化到托盘" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                                <TextBlock Text="点击右上角关闭按钮时隐藏窗口至托盘，不退出后台" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,14,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="2" IsChecked="{Binding MinimizeToTray}" Checked="SettingsMinimizeToTray_Changed" Unchecked="SettingsMinimizeToTray_Changed" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <Border Background="{DynamicResource SeparatorBrush}" Height="0.5" Margin="14,0"/>

                                                    <!-- 强制关闭 Steam -->
                                                    <Border Padding="16,10" Style="{StaticResource SettingRowStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" CornerRadius="9" Background="#33FF453A" Margin="0,0,11,0"><TextBlock Text="&#xE75A;" FontFamily="Segoe MDL2 Assets" Foreground="#FFFF6961" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
