                                    <ToggleButton Grid.Column="3" VerticalAlignment="Center" Width="32" Height="32" Cursor="Hand" Margin="6,0,0,0"
                                                  IsChecked="{Binding IsPinned, Mode=OneWay}" Click="GameItemPinToggle_Click">
                                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{DynamicResource CardBgAltBrush}" CornerRadius="8" Width="32" Height="32" x:Name="gpb" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45" x:Name="gpi"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="gpb" Property="Background" Value="{DynamicResource HoverBgBrush}"/><Setter TargetName="gpi" Property="Opacity" Value="0.8"/></Trigger>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="gpb" Property="Background" Value="{DynamicResource AccentBgBrush}"/><Setter TargetName="gpb" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="gpi" Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="gpi" Property="Opacity" Value="1"/></Trigger>
                                            </ControlTemplate.Triggers>
