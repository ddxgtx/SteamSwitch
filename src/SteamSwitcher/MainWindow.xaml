                                                <Border Background="{DynamicResource ToggleBgBrush}" CornerRadius="9" Width="128" Height="34" x:Name="pb">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="pi" Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Opacity="0.45"/>
                                                        <TextBlock x:Name="pt" Text="固定到任务栏" FontSize="12" Foreground="#8E8E96" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pb" Property="Background" Value="{DynamicResource ToggleHoverBgBrush}"/><Setter TargetName="pi" Property="Opacity" Value="0.7"/></Trigger>
                                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="pi" Property="Opacity" Value="1"/><Setter TargetName="pi" Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="pt" Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate></ToggleButton.Template>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 快速启动视图 -->
