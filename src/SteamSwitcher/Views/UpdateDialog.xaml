<Window Style="{StaticResource DialogWindowStyle}" FontSize="13" x:Class="SteamSwitcher.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="540" Height="470"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" PreviewKeyDown="Window_PreviewKeyDown">

    <Border Style="{StaticResource DialogShellStyle}" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource DialogHeaderIconStyle}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="发现新版本" Style="{StaticResource DialogTitleStyle}"/>
                        <TextBlock x:Name="VersionText" Text="v0.0.0" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource DialogCloseButtonStyle}" Click="Close_Click" VerticalAlignment="Top" ToolTip="关闭"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="CurrentVersionText" Text="当前版本：v0.0.0"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <Border x:Name="IntegrityBadge" Background="{DynamicResource SuccessBgBrush}" CornerRadius="8" Padding="9,6" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="IntegrityIcon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessFgBrush}" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock x:Name="IntegrityText" Text="GitHub 官方源 · SHA-256 完整性校验" Foreground="{DynamicResource SuccessFgBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ChangelogText" Text="正在加载..."
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                               TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DownloadStatusText" Text="正在下载..." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="DownloadPercentText" Text="0%"
                               Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <Border Grid.Row="1" Height="6" CornerRadius="3" Background="{DynamicResource CardBgBrush}" Margin="0,6,0,0">
                    <ProgressBar x:Name="DownloadProgressBar" Height="6"
                                 Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentBrush}"
                                 Background="Transparent" BorderThickness="0"/>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="IgnoreButton" Content="稍后提醒" Width="96" Height="40" Click="Ignore_Click" IsCancel="True"
                        Style="{StaticResource DialogSecondaryButtonStyle}" FontSize="12" Margin="0,0,10,0"/>
                <Button x:Name="DownloadButton" Content="立即更新" Width="112" Height="40" Click="Download_Click" IsDefault="True"
                        Style="{StaticResource DialogPrimaryButtonStyle}" FontSize="12"/>
                <Button x:Name="CancelButton" Content="取消下载" Width="90" Height="40" Click="Cancel_Click"
                        Style="{StaticResource DialogSecondaryButtonStyle}" FontSize="12" Visibility="Collapsed"/>
                <Button x:Name="InstallButton" Content="立即安装" Width="90" Height="40" Click="Install_Click" IsDefault="True"
                        Style="{StaticResource DialogPrimaryButtonStyle}" FontSize="12" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
