<Window x:Class="SteamSwitcher.Views.DesktopFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Switch Floating"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">

    <Grid Margin="12">
        <Border x:Name="RootGlass"
                CornerRadius="22"
                Padding="10,7"
                BorderThickness="1"
                BorderBrush="#52FFFFFF">
            <Border.Effect>
                <DropShadowEffect Color="#07111F" BlurRadius="30" ShadowDepth="5" Opacity="0.38"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E51A2A3D" Offset="0"/>
                    <GradientStop Color="#D5111D2B" Offset="0.52"/>
                    <GradientStop Color="#E2163550" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel Margin="6,4" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="2,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#FF35C9FF" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Border.Effect><DropShadowEffect Color="#FF35C9FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                        </Border>
                        <TextBlock Text="Steam Switch" Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="HintText" Text="桌面快捷入口" Foreground="#AFC9D7E8" FontSize="9.5" Margin="12,2,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" Width="1" Margin="0,6,8,6" Background="#40FFFFFF"/>
                <StackPanel DockPanel.Dock="Right" x:Name="AvatarPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right"
                        x:Name="GameAvatarSeparator"
                        Width="1" Margin="6,8"
                        Background="#40FFFFFF"
                        Visibility="Collapsed"/>
                <StackPanel DockPanel.Dock="Right" x:Name="GamePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
