<Window Style="{StaticResource DialogWindowStyle}" FontSize="13" x:Class="SteamSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Height="620" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="BtnWindow" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="bg">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnWindow}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="bg">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource CardBgAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" x:Name="b">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource DialogShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0">
                <Grid Height="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource DialogHeaderIconStyle}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="设置" Style="{StaticResource DialogTitleStyle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button Content="&#xE8BB;" Style="{StaticResource DialogCloseButtonStyle}" Click="Close_Click" ToolTip="关闭"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,12">
                <StackPanel Margin="16,0">
                    <!-- 常规 -->
                    <TextBlock Text="常规设置" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,8"/>

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="0,0,0,16" Padding="0">
                        <StackPanel>
                            <Border Padding="16,14">
                                <CheckBox Content="切换后自动启动 Steam" IsChecked="{Binding AutoStartSteam}" Style="{StaticResource DialogCheckBoxStyle}"/>
                            </Border>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1"/>
                            <Border Padding="16,14">
                                <CheckBox Content="关闭窗口时最小化到托盘" IsChecked="{Binding MinimizeToTray}" Style="{StaticResource DialogCheckBoxStyle}"/>
                            </Border>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1"/>
                            <Border Padding="16,14">
                                <CheckBox Content="开机自动启动" IsChecked="{Binding StartWithWindows}" Style="{StaticResource DialogCheckBoxStyle}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 自定义路径 -->
                    <TextBlock Text="自定义 Steam 路径" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,8"/>

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="0,0,0,16" Padding="0">
                        <StackPanel>
                            <Border Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Steam 安装路径" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                        <TextBlock Text="{Binding CustomSteamPath, TargetNullValue='未设置（自动检测）', FallbackValue='未设置（自动检测）'}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="浏览" Click="SelectSteamPath_Click" Width="54" Height="28" Style="{StaticResource PathBtn}"/>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1"/>
                            <Border Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="loginusers.vdf 路径" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"/>
                                        <TextBlock Text="{Binding CustomLoginUsersPath, TargetNullValue='未设置（自动检测）', FallbackValue='未设置（自动检测）'}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="浏览" Click="SelectLoginUsersPath_Click" Width="54" Height="28" Style="{StaticResource PathBtn}"/>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1"/>
                            <Border Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="恢复自动检测路径" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="重置" Click="ResetPaths_Click" Width="54" Height="28" Style="{StaticResource PathBtn}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 任务栏常驻 -->
                    <TextBlock Text="任务栏常驻设置" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,8"/>

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="0,0,0,16" Padding="0">
                        <StackPanel>
                            <Border Padding="16,14">
                                <CheckBox Content="启用任务栏常驻" IsChecked="{Binding IsTaskbarPinned}" Style="{StaticResource DialogCheckBoxStyle}"/>
                            </Border>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1"/>
                            <Border Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="显示位置" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton Content="自动" IsChecked="True" Margin="0,0,8,0" GroupName="TaskbarPos" Checked="Position_Changed" x:Name="PosAuto" Style="{StaticResource DialogRadioButtonStyle}"/>
                                        <RadioButton Content="左" Margin="0,0,8,0" GroupName="TaskbarPos" Checked="Position_Changed" x:Name="PosLeft" Style="{StaticResource DialogRadioButtonStyle}"/>
                                        <RadioButton Content="中" Margin="0,0,8,0" GroupName="TaskbarPos" Checked="Position_Changed" x:Name="PosCenter" Style="{StaticResource DialogRadioButtonStyle}"/>
                                        <RadioButton Content="右" GroupName="TaskbarPos" Checked="Position_Changed" x:Name="PosRight" Style="{StaticResource DialogRadioButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1"/>
                            <Border Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="位置偏移" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="OffsetSlider" Width="100" Minimum="-1000" Maximum="1000" Value="0" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OffsetSlider_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="OffsetText" Text="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Width="36" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1"/>
                            <Border Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="头像大小" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider x:Name="AvatarSizeSlider" Width="100" Minimum="32" Maximum="56" Value="40" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="AvatarSizeSlider_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AvatarSizeText" Text="40" Foreground="{DynamicResource AccentBrush}" FontSize="12" Width="32" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1"/>
                            <Border Padding="16,14">
                                <CheckBox Content="液态玻璃效果" IsChecked="{Binding TaskbarGlassEnabled}" Checked="Glass_Checked" Unchecked="Glass_Unchecked" Style="{StaticResource DialogCheckBoxStyle}"/>
                            </Border>
                            <Border Background="{DynamicResource SeparatorBrush}" Height="1"/>
                            <Border Padding="16,14">
                                <CheckBox Content="圆角模式" IsChecked="{Binding TaskbarRoundedMode}" Checked="Rounded_Checked" Unchecked="Rounded_Unchecked" Style="{StaticResource DialogCheckBoxStyle}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部完成按钮 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <Button Content="完成" Width="96" Height="40" HorizontalAlignment="Right" Click="Close_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="b">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
