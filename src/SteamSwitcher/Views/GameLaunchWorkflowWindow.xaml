<Window Style="{StaticResource DialogWindowStyle}" FontSize="13" x:Class="SteamSwitcher.Views.GameLaunchWorkflowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏启动工作流" Width="640" Height="660"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI, sans-serif"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed">

    <Window.Resources>
        <Style x:Key="WorkflowBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryWorkflowBtn" TargetType="Button" BasedOn="{StaticResource WorkflowBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource DialogShellStyle}" Padding="24">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource DialogHeaderIconStyle}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="游戏启动工作流" Style="{StaticResource DialogTitleStyle}"/>
                        <TextBlock x:Name="GameSummaryText" Style="{StaticResource DialogSubtitleStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource DialogCloseButtonStyle}" Click="Cancel_Click" ToolTip="关闭"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,18">
                <StackPanel>
                    <TextBlock Text="启动参数" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                    <TextBox x:Name="LaunchArgumentsBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,8,0,4"/>
                    <TextBlock Text="参数将通过 Steam 启动协议传递；最长 2048 个字符。" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"/>

                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,20,0,0" Padding="16,10">
                        <StackPanel>
                            <CheckBox x:Name="BackupBeforeLaunchCheck" Margin="0,10" Content="启动前备份存档" FontWeight="SemiBold" Style="{StaticResource DialogCheckBoxStyle}"/>
                            <TextBlock Text="备份失败时取消启动，避免在没有保护点的情况下覆盖进度。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="24,-6,0,8"/>
                            <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                            <CheckBox x:Name="BackupAfterExitCheck" Margin="0,12" Content="游戏退出后备份存档" FontWeight="SemiBold" Style="{StaticResource DialogCheckBoxStyle}"/>
                            <TextBlock Text="监测安装目录中的游戏进程，完全退出并停止写入后创建备份。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="24,-8,0,8"/>
                            <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                            <CheckBox x:Name="CloseSteamAfterExitCheck" Margin="0,12" Content="游戏退出后关闭 Steam" FontWeight="SemiBold" Style="{StaticResource DialogCheckBoxStyle}"/>
                            <Border Height="1" Background="{DynamicResource SeparatorBrush}"/>
                            <CheckBox x:Name="BigPictureCheck" Margin="0,12" Content="使用 Steam 大屏幕模式启动" FontWeight="SemiBold" Style="{StaticResource DialogCheckBoxStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AccentBgBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="退出后任务只对从 SteamSwitch 启动且能识别到安装目录的游戏生效。受保护的反作弊进程可能无法被监测。"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="取消" Click="Cancel_Click" Style="{StaticResource DialogSecondaryButtonStyle}" Margin="0,0,6,0" IsCancel="True"/>
                <Button Grid.Column="1" Content="保存工作流" Click="Save_Click" Style="{StaticResource DialogPrimaryButtonStyle}" Margin="6,0,0,0" IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
