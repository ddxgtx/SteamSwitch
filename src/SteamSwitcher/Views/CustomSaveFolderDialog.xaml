<Window Style="{StaticResource DialogWindowStyle}" FontSize="13" x:Class="SteamSwitcher.Views.CustomSaveFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加自定义存档目录" Icon="../Resources/steam.ico"
        Width="580" Height="430" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <Style x:Key="DialogActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogActionBtn" TargetType="Button" BasedOn="{StaticResource DialogActionBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource DialogShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="68"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource DialogHeaderIconStyle}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="添加自定义存档目录" Style="{StaticResource DialogTitleStyle}"/>
                            <TextBlock Text="为本地存档建立可验证的版本备份" Style="{StaticResource DialogSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource DialogCloseButtonStyle}" Click="Cancel_Click" ToolTip="关闭"/>
                </Grid>
            </Border>

            <!-- 输入表单 -->
            <StackPanel Grid.Row="1" Margin="22,16">
                <TextBlock Text="游戏名称" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <TextBox x:Name="GameNameBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,6,0,12" ToolTip="例如：赛博朋克 2077"/>

                <TextBlock Text="所属 Steam 账号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <ComboBox x:Name="AccountCombo" Height="40" Margin="0,6,0,12" DisplayMemberPath="DisplayName" FontSize="13" Style="{StaticResource SaveComboBox}"/>

                <TextBlock Text="存档绝对目录" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderPathBox" Style="{StaticResource FormTextBoxStyle}" FontSize="12" ToolTip="可选择现有目录，或输入完整路径以恢复已丢失的存档"/>
                    <Button Grid.Column="1" Content="选择目录..." Style="{StaticResource DialogSecondaryButtonStyle}" Margin="8,0,0,0" Click="Browse_Click"/>
                </Grid>
            </StackPanel>

            <!-- 底部操作按钮 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="取消" Style="{StaticResource DialogSecondaryButtonStyle}" Margin="0,0,10,0" Width="88" Click="Cancel_Click" IsCancel="True"/>
                    <Button Content="添加目录" Style="{StaticResource DialogPrimaryButtonStyle}" Width="100" Click="Add_Click" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
