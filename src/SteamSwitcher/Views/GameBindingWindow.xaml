<Window Style="{StaticResource DialogWindowStyle}" FontSize="13" x:Class="SteamSwitcher.Views.GameBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏账号绑定"
        Height="740" Width="980"
        MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI, sans-serif"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" PreviewKeyDown="Window_PreviewKeyDown">

    <!-- WindowStyle=None + AllowsTransparency 的窗口没有系统缩放边框。不挂 WindowChrome 时
         WM_NCHITTEST 在四条边上都返回 HTCLIENT（仅右下角因 CanResizeWithGrip 的抓地而有效），
         用户根本无法拖动边框改大小，MinWidth/MinHeight 成了空声明。CaptionHeight=0 让标题栏
         拖动继续走 Window_MouseLeftButtonDown + WindowDragHelper，chrome 只提供缩放热区。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="BtnWindow" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="bg">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnWindow}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="bg">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" x:Name="b">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" x:Name="b">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
        </Style>

        <DataTemplate x:Key="GameItemTemplate">
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="14" Margin="0,3"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#101828" BlurRadius="8" ShadowDepth="1" Opacity="0.025"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                            Background="{DynamicResource AccentBgBrush}" Margin="0,0,14,0" ClipToBounds="True"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding IconPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="5" Padding="6,2">
                                <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"/>
                            </Border>
                            <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="5" Padding="6,2" Margin="6,0,0,0"
                                     Visibility="{Binding HasBinding, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding BindingAccountName, StringFormat='绑定: {0}'}"
                                           Foreground="{DynamicResource SuccessFgBrush}" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <ToggleButton Grid.Column="2" IsChecked="{Binding IsPinned, Mode=OneWay}"
                                  ToolTip="固定到任务栏" Width="32" Height="32" Background="Transparent"
                                  BorderThickness="0" Cursor="Hand" Click="ToggleGamePin_Click">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Width="32" Height="32">
                                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="icon"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="icon" Property="Text" Value="&#xE77A;"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="GameListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="MinHeight" Value="68"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                            Margin="0,1" x:Name="b">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource DialogShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0">
                <Grid Height="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource DialogHeaderIconStyle}" Margin="0,0,11,0">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="游戏账号绑定" Style="{StaticResource DialogTitleStyle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GameCountLabel" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button Content="&#xE8BB;" Style="{StaticResource DialogCloseButtonStyle}" Click="Close_Click" ToolTip="关闭"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>

            <!-- 主体内容 -->
            <Grid Grid.Row="1" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：游戏列表 -->
                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索与扫描行 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,10,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="13"/>
                                <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
                                <Button Grid.Column="2" x:Name="ClearSearchBtn" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                        Width="24" Height="24" FontSize="12" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                                        Click="ClearSearch_Click" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Content="扫描" Style="{StaticResource SecondaryBtn}" Height="36" Width="72" Click="ScanGames_Click"/>
                    </Grid>

                    <!-- 游戏列表卡片 -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBgAltBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <ListBox x:Name="GameListBox"
                                     ItemsSource="{Binding GameList, UpdateSourceTrigger=PropertyChanged}"
                                     SelectedItem="{Binding SelectedGame, UpdateSourceTrigger=PropertyChanged}"
                                     ItemTemplate="{StaticResource GameItemTemplate}"
                                     Style="{StaticResource GameListStyle}"
                                     Padding="8"/>
                            <TextBlock Text="点击 [扫描] 加载本地 Steam 游戏" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- 手动添加入口 -->
                    <Border Grid.Row="3" Margin="0,8,0,0">
                        <Button x:Name="ManualAddToggle" Content="+ 手动添加游戏" Style="{StaticResource SecondaryBtn}" Height="34" Click="ManualAddToggle_Click"/>
                    </Border>
                </Grid>

                <!-- 右侧：绑定面板 -->
                <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="14" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="绑定设置" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="为游戏指定启动前切换的 Steam 账号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 选中游戏信息 + 绑定状态 -->
                        <StackPanel Grid.Row="1">
                            <Border Background="{DynamicResource CardBgAltBrush}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="已选游戏" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedGameName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedGameAppId, StringFormat='AppID: {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                    Visibility="{Binding SelectedGameHasBinding, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="已绑定账号" Foreground="{DynamicResource SuccessFgBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedGameBindingAccount}" Foreground="{DynamicResource SuccessFgBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding SelectedGameBindingTime, StringFormat='绑定时间: {0}'}" Foreground="{DynamicResource SuccessFgBrush}" FontSize="12" Margin="0,2,0,0" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 账号选择 -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="选择账号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,6"/>
                            <ListBox x:Name="AccountListBox"
                                     ItemsSource="{Binding Accounts}"
                                     SelectedItem="{Binding SelectedBindingAccount}"
                                     Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                     Padding="4">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Height" Value="48"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="0,1" x:Name="b" Padding="8,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBgBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SuccessBgBrush}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="当前" Foreground="{DynamicResource SuccessFgBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBgBrush}"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBgBrush}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <Button Content="保存绑定" Style="{StaticResource PrimaryBtn}" Height="38" Click="SaveBinding_Click" Margin="0,0,0,6"/>
                            <Button Content="删除绑定" Style="{StaticResource DangerBtn}" Height="34" Click="RemoveBinding_Click"
                                    Visibility="{Binding SelectedGameHasBinding, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 手动添加面板(可折叠) -->
            <Border Grid.Row="1" x:Name="ManualAddPanel" Background="{DynamicResource CardBgBrush}" CornerRadius="12"
                    Padding="14,12" Margin="20,8,20,8" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="AppID" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="ManualAppIdInput" Style="{StaticResource FormTextBoxStyle}" Height="42" Padding="11,0" FontSize="13" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2" Text="游戏名" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="3" x:Name="ManualGameNameInput" Style="{StaticResource FormTextBoxStyle}" Height="42" Padding="11,0" FontSize="13" Margin="0,0,12,0"/>
                    <Button Grid.Column="4" Content="添加绑定" Style="{StaticResource PrimaryBtn}" Height="42" Click="ManualAddBinding_Click" Margin="0,0,8,0" Width="92"/>
                    <Button Grid.Column="5" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="28" Height="28" FontSize="12" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="ManualAddToggle_Click"/>
                </Grid>
            </Border>

            <!-- 底部栏 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="关闭" Style="{StaticResource SecondaryBtn}" Width="82" Height="34" Click="Close_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
