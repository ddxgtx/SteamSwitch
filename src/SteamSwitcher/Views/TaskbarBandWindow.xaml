<Window x:Class="SteamSwitcher.Views.TaskbarBandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteamSwitcher.Controls"
        Title="Steam Switch Taskbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="220"
        Height="42"
        SizeToContent="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI Semibold, Segoe UI, sans-serif"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Auto">

    <!-- SizeToContent 必须是 Manual：WidthAndHeight 会让 WPF 在每次内容测量后自动
         调整窗口尺寸，而歌词每句都在变——歌词岛于是被反复 resize。AllowsTransparency
         的 layered 窗口每 resize 一次就整窗重绘一次，看上去就是"整个窗口在闪"。
         窗口尺寸改由 ApplyLayout() 显式管理。 -->

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource FloatingTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FloatingSolidBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}" Margin="6">
                            <Border.Effect><DropShadowEffect Color="#171C32" BlurRadius="12" ShadowDepth="2" Opacity="0.16"/></Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaControlButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource GlassTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FloatingButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="13" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FloatingHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GlassAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FloatingAccentBrush}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FloatingPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayPauseControlButton" TargetType="Button" BasedOn="{StaticResource MediaControlButton}">
            <Setter Property="Foreground" Value="{DynamicResource GlassAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FloatingHoverBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Grid x:Name="BandContent" Width="220" Height="42">
        <Border x:Name="GlassBorder"
                Background="Transparent"
                BorderThickness="1"
                ClipToBounds="True">

            <DockPanel x:Name="ContentPanel" LastChildFill="False">
                <!-- 左侧：独立歌词岛 (无边框直接融入任务栏，放大字号与封面) -->
                <controls:RoundedClipBorder DockPanel.Dock="Left"
                        x:Name="LyricsHost"
                        Height="40"
                        Margin="0,0,14,0"
                        BorderBrush="{DynamicResource CompactBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        AutomationProperties.Name="任务栏歌词与媒体控制"
                        MouseEnter="LyricsHost_MouseEnter"
                        MouseLeave="LyricsHost_MouseLeave"
                        MouseLeftButtonUp="LyricsHost_MouseLeftButtonUp"
                        PreviewMouseWheel="LyricsHost_PreviewMouseWheel" Background="{DynamicResource CompactSurfaceBrush}">
                    <Grid>
                        <!-- 顶部极光氛围灯带：玻璃/实体胶囊模式下在顶部边缘勾勒轻柔声波流光 -->
                        <Border x:Name="LyricsAmbientRim" Height="1.5" VerticalAlignment="Top" Margin="20,0,50,0" CornerRadius="1" Opacity="0.55" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0038F9D7" Offset="0.0"/>
                                    <GradientStop Color="#9938F9D7" Offset="0.22"/>
                                    <GradientStop Color="#BB6AA7FF" Offset="0.52"/>
                                    <GradientStop Color="#99C084FC" Offset="0.82"/>
                                    <GradientStop Color="#00C084FC" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="8,0,7,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧/中间：放大双行歌词（右对齐，第一排歌词 + 第二排翻译）与悬停控制器 -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel x:Name="LyricsTextPanel" HorizontalAlignment="Stretch" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <!-- 不要给歌词面板或 TextBlock 加 BitmapCache / DropShadowEffect：
                                     任何 Effect 都会把文字先栅格化进离屏位图再做双线性采样与阴影模糊，
                                     导致小字号中文笔画糊成一团。保持纯矢量字形直出才能锐利清晰。 -->
                                <StackPanel.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="LyricsTextScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="LyricsTranslate" Y="0"/>
                                    </TransformGroup>
                                </StackPanel.RenderTransform>
                                <!-- 文字配色由玻璃 / 透明背景模式选择，保持清晰对比。 -->
                                <TextBlock x:Name="LyricText" FontFamily="Microsoft YaHei UI, Segoe UI Semibold, Segoe UI, sans-serif" Foreground="{DynamicResource CompactTextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right" TextTrimming="CharacterEllipsis" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                <!-- 有限宽度让长翻译正确省略，不再由水平 StackPanel 无限测量。 -->
                                <Grid HorizontalAlignment="Right" Margin="0,1,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 固定占位 14px：用不透明度而非可见性隐藏，避免
                                         切歌时图标出现/消失让副行文字左右跳一格 -->
                                    <TextBlock x:Name="MediaIcon" Width="14" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource CompactAccentBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" SnapsToDevicePixels="True"/>
                                    <TextBlock x:Name="MediaText" Grid.Column="1" FontFamily="Microsoft YaHei UI, Segoe UI Semibold, Segoe UI, sans-serif" Foreground="{DynamicResource CompactTextSecondaryBrush}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Stretch" TextAlignment="Right" TextTrimming="CharacterEllipsis" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                </Grid>
                            </StackPanel>

                            <!-- Lyricify 式悬浮控制条：同一块液态玻璃材质，浮在上层
                                 （ZIndex 高于歌词），歌词横向让位而不是被抹掉。 -->
                            <Border x:Name="LyricsControlsGlass" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="18" Padding="4" BorderThickness="1" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="1,0.5" Panel.ZIndex="3">
                                <!-- 同理不加 BitmapCache：悬停时该玻璃条有缩放/位移动画，缓存会糊掉字形 -->
                                <Border.Background><DynamicResource ResourceKey="FloatingSurfaceBrush"/></Border.Background><Border.BorderBrush><DynamicResource ResourceKey="FloatingBorderBrush"/></Border.BorderBrush>
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="LyricsControlsScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="LyricsControlsTranslate" X="6"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <StackPanel x:Name="LyricsControls" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PrevButton" Content="&#xE892;" Click="PreviousTrack_Click" ToolTip="上一首" Style="{StaticResource MediaControlButton}" AutomationProperties.Name="上一首"/>
                                    <Button x:Name="PlayPauseButton" Content="&#xE768;" Click="PlayPause_Click" ToolTip="播放 / 暂停" Style="{StaticResource PlayPauseControlButton}" AutomationProperties.Name="播放或暂停"/>
                                    <Button x:Name="NextButton" Content="&#xE893;" Click="NextTrack_Click" ToolTip="下一首" Style="{StaticResource MediaControlButton}" AutomationProperties.Name="下一首"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 右侧：36x36 放大高清圆角专辑封面 + 双环反向流光星环 + 对称声波频谱胶囊 -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="9,0,1,0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ArtworkScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <!-- 外层反向流光伴随环：与内环反向旋转，形成唱片律动星环质感 -->
                            <Border x:Name="VisualizerOuterHalo" Width="38" Height="38" Margin="-1" CornerRadius="9" BorderThickness="0.9" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                        <LinearGradientBrush.Transform>
                                            <RotateTransform x:Name="VisualizerOuterRotate" Angle="0" CenterX="19" CenterY="19"/>
                                        </LinearGradientBrush.Transform>
                                        <GradientStop Color="#99C084FC" Offset="0.0"/>
                                        <GradientStop Color="#225AC8FA" Offset="0.45"/>
                                        <GradientStop Color="#9938F9D7" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>

                            <Border x:Name="ArtworkBorder" Width="36" Height="36" CornerRadius="8" BorderBrush="{DynamicResource CompactBorderBrush}" BorderThickness="1" ClipToBounds="True" Background="{DynamicResource CompactSurfaceBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1.5" Opacity="0.2"/>
                                </Border.Effect>
                                <Grid>
                                    <TextBlock x:Name="ArtworkFallback" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource CompactTextPrimaryBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="AlbumArtwork" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="当前专辑封面"/>
                                </Grid>
                            </Border>

                            <!-- 封面极光流光呼吸环：随音乐律动旋转流光色相与呼吸亮度 -->
                            <Border x:Name="VisualizerAuraRing" Width="36" Height="36" CornerRadius="8" BorderThickness="1.4" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.Transform>
                                            <RotateTransform x:Name="VisualizerAuraRotate" Angle="0" CenterX="18" CenterY="18"/>
                                        </LinearGradientBrush.Transform>
                                        <GradientStop Color="#FF38F9D7" Offset="0.0"/>
                                        <GradientStop Color="#FF5AC8FA" Offset="0.35"/>
                                        <GradientStop Color="#FF818CF8" Offset="0.7"/>
                                        <GradientStop Color="#FFC084FC" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>

                            <!-- 悬浮 7 段中心对称极光声波频谱胶囊 -->
                            <Border x:Name="VisualizerBadge" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1.5" Height="12" Background="#E2091120" BorderBrush="#887CE7FF" BorderThickness="0.85" CornerRadius="6" Padding="3.4,1" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border x:Name="VisualizerBar1" Width="1.7" Height="2.4" CornerRadius="0.85" Margin="0.55,0" VerticalAlignment="Center" Opacity="0.55">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF38F9D7" Offset="0"/>
                                                <GradientStop Color="#FF4FACFE" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="VisualizerBar2" Width="1.7" Height="3.4" CornerRadius="0.85" Margin="0.55,0" VerticalAlignment="Center" Opacity="0.65">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF64D2FF" Offset="0"/>
                                                <GradientStop Color="#FF5B93F0" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="VisualizerBar3" Width="1.7" Height="4.4" CornerRadius="0.85" Margin="0.55,0" VerticalAlignment="Center" Opacity="0.75">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF8BE9FD" Offset="0"/>
                                                <GradientStop Color="#FF7C83FD" Offset="0.55"/>
                                                <GradientStop Color="#FF6AA7FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="VisualizerBar4" Width="1.8" Height="5.4" CornerRadius="0.9" Margin="0.55,0" VerticalAlignment="Center" Opacity="0.85">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFA5F3FC" Offset="0"/>
                                                <GradientStop Color="#FF818CF8" Offset="0.5"/>
                                                <GradientStop Color="#FFE879F9" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="VisualizerBar5" Width="1.7" Height="4.4" CornerRadius="0.85" Margin="0.55,0" VerticalAlignment="Center" Opacity="0.75">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF8BE9FD" Offset="0"/>
                                                <GradientStop Color="#FF7C83FD" Offset="0.55"/>
                                                <GradientStop Color="#FF6AA7FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="VisualizerBar6" Width="1.7" Height="3.4" CornerRadius="0.85" Margin="0.55,0" VerticalAlignment="Center" Opacity="0.65">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF64D2FF" Offset="0"/>
                                                <GradientStop Color="#FF5B93F0" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="VisualizerBar7" Width="1.7" Height="2.4" CornerRadius="0.85" Margin="0.55,0" VerticalAlignment="Center" Opacity="0.55">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF38F9D7" Offset="0"/>
                                                <GradientStop Color="#FF4FACFE" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 底部极光星轨进度条：固定宽度并右对齐到歌词列，末端带双层微光彗星节点 -->
                        <ProgressBar x:Name="LyricsProgress" Grid.ColumnSpan="2" Width="102" HorizontalAlignment="Right" Height="6" Margin="0,0,46,0" VerticalAlignment="Bottom" Minimum="0" Maximum="1" Value="0" Background="{DynamicResource CompactSubtleBrush}" Foreground="{DynamicResource CompactAccentBrush}" BorderThickness="0">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="PART_Track">
                                        <Border Background="{TemplateBinding Background}" Height="2" VerticalAlignment="Center" CornerRadius="1"/>
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Height="2" VerticalAlignment="Center" CornerRadius="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#38F9D7" Offset="0"/>
                                                    <GradientStop Color="#5AC8FA" Offset="0.38"/>
                                                    <GradientStop Color="#818CF8" Offset="0.74"/>
                                                    <GradientStop Color="#E879F9" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Ellipse Width="7" Height="7" Fill="#447CE7FF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-3,0"/>
                                                <Ellipse Width="4" Height="4" Fill="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-1.5,0">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#7CE7FF" BlurRadius="6" ShadowDepth="0" Opacity="0.95"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        </Grid>
                    </Grid>
                </controls:RoundedClipBorder>

                <!-- 右侧：独立游戏与头像管理玻璃框 (独立分离) -->
                <controls:RoundedClipBorder DockPanel.Dock="Right"
                        x:Name="GameAvatarContainer"
                        VerticalAlignment="Center"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="1.5" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="GamePanel" Orientation="Horizontal"/>
                        <Border x:Name="GameAvatarSeparator"
                                Width="1" Margin="4,4"
                                Background="{DynamicResource FloatingSubtleBrush}"
                                Visibility="Collapsed"/>
                        <StackPanel x:Name="AvatarPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </controls:RoundedClipBorder>
            </DockPanel>
        </Border>
    </Grid>
    </Viewbox>

</Window>
