<Application x:Class="SteamSwitcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/MenuStyles.xaml"/>
                <ResourceDictionary Source="Resources/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DrawingGroup x:Key="AppIcon">
                <GeometryDrawing Brush="#0A84FF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,48,48" RadiusX="10" RadiusY="10"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#1C1C1E">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4,4,40,40" RadiusX="7" RadiusY="7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M16,14 L16,24 M24,14 L24,34 M32,24 L32,34 M12,14 L20,14 M20,34 L28,34 M28,24 L36,24"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="3" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>

            <!-- Semantic palette defaults; ThemeManager applies the selected appearance at startup. -->
            <SolidColorBrush x:Key="WindowBgBrush" Color="#F3F5F9"/>
            <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBgAltBrush" Color="#F6F8FB"/>
            <SolidColorBrush x:Key="SidebarBgBrush" Color="#F9FAFC"/>
            <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="#E8EFFB"/>
            <SolidColorBrush x:Key="SidebarActiveFgBrush" Color="#175EC9"/>
            <SolidColorBrush x:Key="SidebarInactiveFgBrush" Color="#4F6078"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#182438"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#53647B"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#1762D7"/>
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentBgBrush" Color="#EAF1FD"/>
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#A9C3EB"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#1254BC"/>
            <SolidColorBrush x:Key="FocusRingBrush" Color="#661762D7"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#DCE3ED"/>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E9EEF5"/>
            <SolidColorBrush x:Key="SeparatorBrush" Color="#E9EEF5"/>
            <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceTintBrush" Color="#F8FAFD"/>
            <SolidColorBrush x:Key="PageHeaderBrush" Color="#182438"/>
            <SolidColorBrush x:Key="SectionLabelBrush" Color="#53647B"/>
            <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SearchPlaceholderFgBrush" Color="#63748C"/>
            <SolidColorBrush x:Key="SearchTextFgBrush" Color="#182438"/>
            <SolidColorBrush x:Key="HoverBgBrush" Color="#EFF3F9"/>
            <SolidColorBrush x:Key="SelectedBgBrush" Color="#EDF3FD"/>
            <SolidColorBrush x:Key="SelectedBgBrush2" Color="#E0EBFC"/>
            <SolidColorBrush x:Key="SuccessBgBrush" Color="#E6F4ED"/>
            <SolidColorBrush x:Key="SuccessFgBrush" Color="#087F5B"/>
            <SolidColorBrush x:Key="WarningBgBrush" Color="#FFF2D9"/>
            <SolidColorBrush x:Key="WarningFgBrush" Color="#925800"/>
            <SolidColorBrush x:Key="DangerBgBrush" Color="#FCECEE"/>
            <SolidColorBrush x:Key="DangerFgBrush" Color="#B92D3B"/>
            <SolidColorBrush x:Key="IconBgBrush" Color="#EAF1FD"/>
            <SolidColorBrush x:Key="AvatarBgBrush" Color="#E5ECF6"/>
            <SolidColorBrush x:Key="ToggleBgBrush" Color="#E5EBF4"/>
            <SolidColorBrush x:Key="ToggleHoverBgBrush" Color="#DCE5F1"/>
            <SolidColorBrush x:Key="ToggleCheckedBgBrush" Color="#1762D7"/>
            <SolidColorBrush x:Key="BtnHoverBgBrush" Color="#EFF3F9"/>
            <SolidColorBrush x:Key="BtnDisabledBgBrush" Color="#ECF0F5"/>
            <SolidColorBrush x:Key="BtnDisabledFgBrush" Color="#7D8BA0"/>
            <SolidColorBrush x:Key="BtnSecondaryFgBrush" Color="#263850"/>
            <SolidColorBrush x:Key="ToggleTrackBgBrush" Color="#CCD5E1"/>
            <SolidColorBrush x:Key="ToggleTrackBorderBrush" Color="#BCC9D9"/>
            <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleTrackCheckedBgBrush" Color="#1762D7"/>
            <SolidColorBrush x:Key="ToggleTrackCheckedBorderBrush" Color="#1254BC"/>
            <SolidColorBrush x:Key="ProgressBgBrush" Color="#E5EBF4"/>
            <SolidColorBrush x:Key="FooterTextBrush" Color="#607086"/>
            <SolidColorBrush x:Key="FooterLinkBrush" Color="#175EC9"/>
            <SolidColorBrush x:Key="ScrollThumbBrush" Color="#6653647B"/>
            <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9953647B"/>
            <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#CC53647B"/>
            <SolidColorBrush x:Key="CompactSurfaceBrush" Color="#F0182434"/>
            <SolidColorBrush x:Key="CompactBorderBrush" Color="#364A63"/>
            <SolidColorBrush x:Key="CompactTextPrimaryBrush" Color="#F4F7FC"/>
            <SolidColorBrush x:Key="CompactTextSecondaryBrush" Color="#B6C6DA"/>
            <SolidColorBrush x:Key="CompactHoverBrush" Color="#293C55"/>
            <SolidColorBrush x:Key="CompactPressedBrush" Color="#344B69"/>
            <SolidColorBrush x:Key="CompactAccentBrush" Color="#6AA7FF"/>
            <SolidColorBrush x:Key="CompactSubtleBrush" Color="#66364A63"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
