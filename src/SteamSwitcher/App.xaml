<Application x:Class="SteamSwitcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DrawingGroup x:Key="AppIcon">
                <GeometryDrawing Brush="#0A84FF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,48,48" RadiusX="10" RadiusY="10"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#1C1C1E">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4,4,40,40" RadiusX="7" RadiusY="7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M16,14 L16,24 M24,14 L24,34 M32,24 L32,34 M12,14 L20,14 M20,34 L28,34 M28,24 L36,24"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="3" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>

            <!-- SteamSwitch visual system: calm Fluent surfaces with a crisp Steam-blue accent -->
            <SolidColorBrush x:Key="WindowBgBrush" Color="#FFF3F6FB"/>
            <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="CardBgAltBrush" Color="#FFF7F9FC"/>
            <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFF8FAFD"/>
            <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="#FFEAF4FF"/>
            <SolidColorBrush x:Key="SidebarActiveFgBrush" Color="#FF0A84FF"/>
            <SolidColorBrush x:Key="SidebarInactiveFgBrush" Color="#FF4B5565"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF10141B"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF647083"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF758196"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
            <SolidColorBrush x:Key="AccentBgBrush" Color="#160A84FF"/>
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#520A84FF"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF0076E8"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#FFDCE4EF"/>
            <SolidColorBrush x:Key="SeparatorBrush" Color="#FFE8EDF4"/>
            <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="SurfaceTintBrush" Color="#F5FFFFFF"/>
            <SolidColorBrush x:Key="FocusRingBrush" Color="#660A84FF"/>
            <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="SearchPlaceholderFgBrush" Color="#FF969DA8"/>
            <SolidColorBrush x:Key="SearchTextFgBrush" Color="#FF111318"/>
            <SolidColorBrush x:Key="HoverBgBrush" Color="#FFF0F4FA"/>
            <SolidColorBrush x:Key="SelectedBgBrush" Color="#FFEBF5FF"/>
            <SolidColorBrush x:Key="SelectedBgBrush2" Color="#FFDDECFF"/>
            <SolidColorBrush x:Key="SuccessBgBrush" Color="#1830D158"/>
            <SolidColorBrush x:Key="SuccessFgBrush" Color="#FF30D158"/>
            <SolidColorBrush x:Key="WarningBgBrush" Color="#18FF9F0A"/>
            <SolidColorBrush x:Key="WarningFgBrush" Color="#FFD97800"/>
            <SolidColorBrush x:Key="DangerBgBrush" Color="#16FF453A"/>
            <SolidColorBrush x:Key="DangerFgBrush" Color="#FFE7382F"/>
            <SolidColorBrush x:Key="IconBgBrush" Color="#FFEBF5FF"/>
            <SolidColorBrush x:Key="AvatarBgBrush" Color="#FFE2EBF5"/>
            <SolidColorBrush x:Key="ToggleBgBrush" Color="#FFE2E7EE"/>
            <SolidColorBrush x:Key="ToggleHoverBgBrush" Color="#FFD5DDE6"/>
            <SolidColorBrush x:Key="ToggleCheckedBgBrush" Color="#FF30D158"/>
            <SolidColorBrush x:Key="BtnHoverBgBrush" Color="#0C141F30"/>
            <SolidColorBrush x:Key="BtnDisabledBgBrush" Color="#FFF0F3F7"/>
            <SolidColorBrush x:Key="BtnDisabledFgBrush" Color="#FF969DA8"/>
            <SolidColorBrush x:Key="ProgressBgBrush" Color="#FFE5EAF0"/>
            <SolidColorBrush x:Key="FooterTextBrush" Color="#FF6C727D"/>
            <SolidColorBrush x:Key="FooterLinkBrush" Color="#FF0A84FF"/>
            <SolidColorBrush x:Key="BtnSecondaryFgBrush" Color="#FF111318"/>
            <SolidColorBrush x:Key="ToggleTrackBgBrush" Color="#FFD5DCE5"/>
            <SolidColorBrush x:Key="ToggleTrackBorderBrush" Color="#FFCCD4DE"/>
            <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="ToggleTrackCheckedBgBrush" Color="#FF30D158"/>
            <SolidColorBrush x:Key="ToggleTrackCheckedBorderBrush" Color="#FF28B84C"/>
            <SolidColorBrush x:Key="ScrollThumbBrush" Color="#30141F30"/>
            <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#50141F30"/>
            <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#70141F30"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
